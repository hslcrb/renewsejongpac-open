// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`reveal — resolve gate > every reveal primitive resolves to WGSL (snapshot) 1`] = `
"fn item(coord: f32, progress: f32, feather: f32, invert: f32) -> f32 {
  let c = select(coord, (1f - coord), (invert > 0f));
  let f = max(feather, 1e-4f);
  let front = ((progress * (1f + (2f * f))) - f);
  return smoothstep((front - f), (front + f), c);
}

fn item_1(color: vec4f, reveal: f32) -> vec4f {
  return vec4f(color.x, color.y, color.z, (color.w * reveal));
}

fn item_2(uv: vec2f, aspect: f32, angleDeg: f32) -> f32 {
  let a = (angleDeg * 0.017453292519943295f);
  let dir = vec2f(cos(a), sin(a));
  let p = vec2f(((uv.x - 0.5f) * aspect), (uv.y - 0.5f));
  let grad = dot(p, dir);
  let ext = (0.5f * ((aspect * abs(dir.x)) + abs(dir.y)));
  return ((grad / (2f * ext)) + 0.5f);
}

fn item_3(uv: vec2f, aspect: f32, center: vec2f) -> f32 {
  let cx = (center.x * aspect);
  let cy = (1f - center.y);
  let rel = vec2f(((uv.x * aspect) - cx), (uv.y - cy));
  let dist = length(rel);
  let dx = max(cx, (aspect - cx));
  let dy = max(cy, (1f - cy));
  let maxDist = length(vec2f(dx, dy));
  return (dist / max(maxDist, 1e-4f));
}

fn item_4(uv: vec2f, aspect: f32, center: vec2f, startDeg: f32, mode: f32) -> f32 {
  let rel = vec2f(((uv.x - center.x) * aspect), (uv.y - (1f - center.y)));
  let ang = atan2(rel.y, rel.x);
  let start = (startDeg * 0.017453292519943295f);
  var frac = ((ang - start) / 6.283185307179586f);
  frac = (frac - floor(frac));
  let ccwCoord = (1f - frac);
  let bothCoord = (min(frac, (1f - frac)) * 2f);
  var coord = select(frac, ccwCoord, (mode > 0.5f));
  coord = select(coord, bothCoord, (mode > 1.5f));
  return coord;
}

struct CellGrid {
  cell: vec2f,
  local: vec2f,
  grid: vec2f,
}

fn item_5(uv: vec2f, aspect: f32, size: f32) -> CellGrid {
  let gridX = (1f / max(size, 1e-3f));
  let gridY = max((gridX / aspect), 1f);
  let sx = (uv.x * gridX);
  let sy = (uv.y * gridY);
  return CellGrid(vec2f(floor(sx), floor(sy)), vec2f(fract(sx), fract(sy)), vec2f(gridX, gridY));
}

fn item_6(t: f32) -> f32 {
  return (abs((t - 0.5f)) * 2f);
}

fn item_7(t: f32, count: f32) -> f32 {
  return fract((t * count));
}

fn item_8(t: f32, count: f32) -> f32 {
  let n = max(count, 1f);
  return clamp(((floor((t * n)) + 0.5f) / n), 0f, 1f);
}

fn floatBitsToUint1(x: f32) -> u32 { return bitcast<u32>(x); }

fn hash11(p: f32) -> f32 {
  let u = floatBitsToUint1((p * 3141592653f));
  return (f32(((u * u) * 3141592653u)) / 4294967296f);
}

fn item_9(t: f32, count: f32) -> f32 {
  let idx = floor((t * max(count, 1f)));
  return hash11((idx + 0.5f));
}

fn item_10(uv: vec2f, aspect: f32, size: f32) -> f32 {
  let g = item_5(uv, aspect, size);
  return (abs((g.local.x - 0.5f)) + abs((g.local.y - 0.5f)));
}

fn item_11(uv: vec2f, aspect: f32, size: f32) -> f32 {
  let g = item_5(uv, aspect, size);
  let parity = (fract(((g.cell.x + g.cell.y) * 0.5f)) * 2f);
  let diag = (((g.cell.x / g.grid.x) + (g.cell.y / g.grid.y)) * 0.5f);
  return clamp(((0.5f * parity) + (0.5f * diag)), 0f, 1f);
}

fn floatBitsToUint2(v: vec2f) -> vec2u { return bitcast<vec2u>(v); }

fn hash12(p: vec2f) -> f32 {
  let u = floatBitsToUint2((p * vec2f(141421360, 2718281728)));
  return (f32(((u.x ^ u.y) * 3141592653u)) / 4294967296f);
}

fn item_12(uv: vec2f, aspect: f32, size: f32) -> f32 {
  return hash12(item_5(uv, aspect, size).cell);
}

fn mxFade(t: f32) -> f32 {
  return (((t * t) * t) * ((t * ((t * 6f) - 15f)) + 10f));
}

fn mxRotl32(x: u32, k: i32) -> u32 {
  return ((x << u32(k)) | (x >> u32((32i - k))));
}

fn mxBjfinal(a0: u32, b0: u32, c0: u32) -> u32 {
  var a = a0;
  var b = b0;
  var c = c0;
  c = (c ^ b);
  c = (c - mxRotl32(b, 14i));
  a = (a ^ c);
  a = (a - mxRotl32(c, 11i));
  b = (b ^ a);
  b = (b - mxRotl32(a, 25i));
  c = (c ^ b);
  c = (c - mxRotl32(b, 16i));
  a = (a ^ c);
  a = (a - mxRotl32(c, 4i));
  b = (b ^ a);
  b = (b - mxRotl32(a, 14i));
  c = (c ^ b);
  c = (c - mxRotl32(b, 24i));
  return c;
}

fn mxHashInt1(x: i32, y: i32) -> u32 {
  const len = 2u;
  let seed = ((3735928559u + (len << 2u)) + 13u);
  let a = (seed + u32(x));
  let b = (seed + u32(y));
  return mxBjfinal(a, b, seed);
}

fn mxGradientFloat2(hash: u32, x: f32, y: f32) -> f32 {
  let h = (hash & 7u);
  let u = select(y, x, (h < 4u));
  let v = (2f * select(x, y, (h < 4u)));
  let uu = select(u, -(u), ((h & 1u) != 0u));
  let vv = select(v, -(v), ((h & 2u) != 0u));
  return (uu + vv);
}

fn mxBilerp(v0: f32, v1: f32, v2: f32, v3: f32, s: f32, t: f32) -> f32 {
  let s1 = (1f - s);
  return (((1f - t) * ((v0 * s1) + (v1 * s))) + (t * ((v2 * s1) + (v3 * s))));
}

fn mxGradientScale2d(v: f32) -> f32 {
  return (0.6616f * v);
}

fn mxPerlinNoiseFloat2(p: vec2f) -> f32 {
  let X = i32(floor(p.x));
  let Y = i32(floor(p.y));
  let fx = (p.x - f32(X));
  let fy = (p.y - f32(Y));
  let u = mxFade(fx);
  let v = mxFade(fy);
  let result = mxBilerp(mxGradientFloat2(mxHashInt1(X, Y), fx, fy), mxGradientFloat2(mxHashInt1((X + 1i), Y), (fx - 1f), fy), mxGradientFloat2(mxHashInt1(X, (Y + 1i)), fx, (fy - 1f)), mxGradientFloat2(mxHashInt1((X + 1i), (Y + 1i)), (fx - 1f), (fy - 1f)), u, v);
  return mxGradientScale2d(result);
}

fn mxNoiseFloat2(p: vec2f) -> f32 {
  return mxPerlinNoiseFloat2(p);
}

fn item_13(uv: vec2f, aspect: f32, scale: f32, seed: f32) -> f32 {
  let p = vec2f((((uv.x * aspect) * scale) + (seed * 13.7f)), ((uv.y * scale) + (seed * 7.9f)));
  let n1 = mxNoiseFloat2(p);
  let n2 = (mxNoiseFloat2(vec2f((((p.x * 2f) + 17.3f) + (seed * 3.1f)), ((p.y * 2f) + 9.1f))) * 0.5f);
  let n3 = (mxNoiseFloat2(vec2f(((p.x * 4f) + 41.7f), (((p.y * 4f) + 27.9f) + (seed * 5.3f)))) * 0.25f);
  let n = (((n1 + n2) + n3) / 1.75f);
  return clamp((0.5f + (n * 0.9f)), 0f, 1f);
}"
`;
