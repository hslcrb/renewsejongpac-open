// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Surface3D (a) UV-context provider path (tryComposeViaUVContext) > dispatches the raymarch compute, samples its uvMaskMap → generator uvContext, composites the link > uv-context 1`] = `
"struct padded {
  _opacity: f32,
  _pad0: f32,
  _pad1: f32,
  _pad2: f32,
}

struct struct_1 {
  amplitude: f32,
  frequency: f32,
  octaves: f32,
  seed: f32,
  speed: f32,
  tilt: f32,
  roll: f32,
  height: f32,
  zoom: f32,
  nearCutoff: f32,
  farCutoff: f32,
  edgePinning: f32,
  edges: f32,
  lighting: f32,
  glossiness: f32,
  highlights: f32,
  lightX: f32,
  lightY: f32,
  lightZ: f32,
  lightColor: vec4f,
  cursorIntensity: f32,
  cursorSpeed: f32,
  _opacity: f32,
}

struct padded_1 {
  _opacity: f32,
  _pad0: f32,
  _pad1: f32,
  _pad2: f32,
}

struct struct_2 {
  time: f32,
  viewportSize: vec2f,
  logicalViewportSize: vec2f,
  aspect: f32,
  pointer: vec2f,
  pointerActive: f32,
}

struct combined {
  n_root: padded,
  n_surf: struct_1,
  n_gen: padded_1,
  _sys: struct_2,
}

@group(0) @binding(0) var<uniform> uniforms: combined;

fn genBody(uv: vec2f) -> vec4f {
  return vec4f(uv.x, uv.y, 0.5f, 1f);
}

@group(1) @binding(0) var compute_0: texture_2d<f32>;

@group(2) @binding(0) var linearClamp: sampler;

fn unpremultiplyAlpha(color2: vec4f) -> vec4f {
  let alpha = color2.w;
  let straightRGB = select(vec3f(), (color2.xyz / alpha), (alpha > 1e-3f));
  return vec4f(straightRGB, alpha);
}

@group(1) @binding(1) var compute_1: texture_2d<f32>;

fn linearToSrgb(color: vec3f) -> vec3f {
  let a = ((pow(color, vec3f(0.41666001081466675)) * 1.055f) - 0.055f);
  let b = (color * 12.92f);
  let factor = (color <= vec3f(0.0031308000907301903));
  return select(a, b, factor);
}

fn tone_linear(color: vec3f) -> vec3f {
  return vec3f(color.x, color.y, color.z);
}

struct final_Input {
  @location(0) uv: vec2f,
}

@fragment fn final_1(in: final_Input) -> @location(0)  vec4f {
  _ = uniforms._sys.time;
  var uv = in.uv;
  let childColor_0 = genBody((vec4f((textureSample(compute_0, linearClamp, uv)).r, (textureSample(compute_0, linearClamp, uv)).g, 0.0, 0.0)).xy);
  let uvMaskSample_1 = textureSample(compute_0, linearClamp, uv);
  var composed_2 = unpremultiplyAlpha(vec4f(clamp((childColor_0.xyz * (textureSample(compute_1, linearClamp, uv)).rgb), vec3f(0.0, 0.0, 0.0), vec3f(1.0, 1.0, 1.0)), (childColor_0.w * uvMaskSample_1.b)));
  return vec4f(linearToSrgb(tone_linear(composed_2.rgb)), composed_2.a);
}"
`;
