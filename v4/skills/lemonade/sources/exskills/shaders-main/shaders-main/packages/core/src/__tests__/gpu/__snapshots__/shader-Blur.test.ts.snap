  outputMax: f32,
  curve: f32,
}

@group(0) @binding(2) var<uniform> params: item;

fn mapSourceScalar_luminance(sample: vec4f) -> f32 {
  return dot(sample.xyz, vec3f(0.2125999927520752, 0.7152000069618225, 0.0722000002861023));
}

fn applyRemapWindow(raw: f32, inputMin: f32, inputMax: f32, outputMin: f32, outputMax: f32, curve: f32) -> f32 {
