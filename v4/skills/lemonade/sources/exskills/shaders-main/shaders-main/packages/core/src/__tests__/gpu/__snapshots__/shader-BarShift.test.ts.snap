@fragment fn final_1(in: final_Input) -> @location(0)  vec4f {
  var uv = vec2f(in.uv.x, 1.0 - in.uv.y);
  var composed_0 = blend_normal(vec4f(1.0, 1.0, 1.0, 0.0), unpremultiplyAlpha(textureSample(rtt_0, linearClamp, edgeMirrorUV(barShiftUV(uniforms.n_bs.count, uniforms.n_bs.angle, uniforms.n_bs.intensity, uniforms.n_bs.seed, uniforms.n_bs._animTime, uv, uniforms._sys.aspect)))), uniforms.n_bs._opacity);
  return vec4f(linearToSrgb(tone_linear(composed_0.rgb)), composed_0.a);
