  let projectedV = (((cu * sinA) * -1f) + (cv * cosA));
  let distPV = (projectedV + offset);
  let dcu = ((projectedU * cosA) - (distPV * sinA));
  let dcv = ((projectedU * sinA) + (distPV * cosA));
  return vec2f(((dcu / aspect) + 0.5f), (dcv + 0.5f));
}

