// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`BarShift (a) analytic UV fold over a generator > folds BarShift.uvRemap into the generator sample coordinate (inline, no RTT); reads _animTime > final-pass-uvremap 1`] = `
"fn edgeClampUV(uv: vec2f) -> vec2f {
  return clamp(uv, vec2f(), vec2f(1));
}

fn legacySinHash11(x: f32) -> f32 {
  return ((fract((sin((x * 12.9898f)) * 43758.5453f)) - 0.5f) * 2f);
}

fn barSampleUV(uv: vec2f, aspect: f32, angle: f32, offset: f32) -> vec2f {
  let angleRad = (angle * 0.017453292519943295f);
  let cosA = cos(angleRad);
  let sinA = sin(angleRad);
  let au = (uv.x * aspect);
  let av = uv.y;
  let cu = (au - (aspect * 0.5f));
  let cv = (av - 0.5f);
  let projectedU = ((cu * cosA) + (cv * sinA));
  let projectedV = (((cu * sinA) * -1f) + (cv * cosA));
  let distPV = (projectedV + offset);
  let dcu = ((projectedU * cosA) - (distPV * sinA));
  let dcv = ((projectedU * sinA) + (distPV * cosA));
  return vec2f(((dcu / aspect) + 0.5f), (dcv + 0.5f));
}

fn barShiftUV(count: f32, angle: f32, intensity: f32, seed: f32, animTime: f32, uv: vec2f, aspect: f32) -> vec2f {
  let angleRad = (angle * 0.017453292519943295f);
  let cosA = cos(angleRad);
  let sinA = sin(angleRad);
  let longestAxis = max(aspect, 1f);
  let au = (uv.x * aspect);
  let av = uv.y;
  let cu = (au - (aspect * 0.5f));
  let cv = (av - 0.5f);
  let projectedU = ((cu * cosA) + (cv * sinA));
  let barCoord = ((projectedU * count) / longestAxis);
  let barIndex = floor(barCoord);
  let seedOffset = (seed * 0.137f);
  let staticOffset = legacySinHash11((barIndex + seedOffset));
  let barSpeed = legacySinHash11(((barIndex + seedOffset) + 42.7f));
  let animOffset = ((animTime * barSpeed) * 0.2f);
  let offset = ((staticOffset + animOffset) * intensity);
  return barSampleUV(uv, aspect, angle, offset);
}

struct padded {
  _opacity: f32,
  _pad0: f32,
  _pad1: f32,
  _pad2: f32,
}

struct struct_1 {
  count: f32,
  angle: f32,
  intensity: f32,
  seed: f32,
  speed: f32,
  edges: f32,
  _opacity: f32,
  _animTime: f32,
}

struct padded_1 {
  seed: f32,
  _opacity: f32,
  _pad0: f32,
  _pad1: f32,
}

struct struct_2 {
  time: f32,
  viewportSize: vec2f,
  logicalViewportSize: vec2f,
  aspect: f32,
  pointer: vec2f,
  pointerActive: f32,
}

struct combined {
  n_root: padded,
  n_bs: struct_1,
  n_gen: padded_1,
  _sys: struct_2,
}

@group(0) @binding(0) var<uniform> uniforms: combined;

fn genBody(seed: f32, uv: vec2f) -> vec4f {
  return vec4f(uv.x, uv.y, seed, 1f);
}

fn linearToSrgb(color: vec3f) -> vec3f {
  let a = ((pow(color, vec3f(0.41666001081466675)) * 1.055f) - 0.055f);
  let b = (color * 12.92f);
  let factor = (color <= vec3f(0.0031308000907301903));
  return select(a, b, factor);
}

fn tone_linear(color: vec3f) -> vec3f {
  return vec3f(color.x, color.y, color.z);
}

struct final_Input {
  @location(0) uv: vec2f,
}

@fragment fn final_1(in: final_Input) -> @location(0)  vec4f {
  var uv = vec2f(in.uv.x, 1.0 - in.uv.y);
  let foldUV_0 = edgeClampUV(barShiftUV(uniforms.n_bs.count, uniforms.n_bs.angle, uniforms.n_bs.intensity, uniforms.n_bs.seed, uniforms.n_bs._animTime, uv, uniforms._sys.aspect));
  var composed_1 = genBody(uniforms.n_gen.seed, foldUV_0);
  return vec4f(linearToSrgb(tone_linear(composed_1.rgb)), composed_1.a);
}"
`;

exports[`BarShift (b) RTT filter path (fragment) > converts the child to a texture, samples the per-bar shift, unpremultiplies > final-pass-fragment 1`] = `
"fn overComposite(base: vec4f, blended: vec3f, overlayAlpha: f32) -> vec4f {
  let baseWeight = (base.w * (1f - overlayAlpha));
  let finalAlpha = (overlayAlpha + baseWeight);
  let rgb = ((blended * overlayAlpha) + (base.xyz * baseWeight));
  return vec4f(rgb, finalAlpha);
}

fn blend_normal(base: vec4f, overlay2: vec4f, opacity: f32) -> vec4f {
  let overlayAlpha = (overlay2.w * opacity);
  return overComposite(base, overlay2.xyz, overlayAlpha);
}

fn unpremultiplyAlpha(color2: vec4f) -> vec4f {
  let alpha = color2.w;
  let straightRGB = select(vec3f(), (color2.xyz / alpha), (alpha > 1e-3f));
  return vec4f(straightRGB, alpha);
}

@group(1) @binding(0) var rtt_0: texture_2d<f32>;

@group(2) @binding(0) var linearClamp: sampler;

fn edgeMirrorUV(uv: vec2f) -> vec2f {
  let mirrorX = (abs(uv.x) % 2f);
  let mirrorY = (abs(uv.y) % 2f);
  return vec2f(select(mirrorX, (2f - mirrorX), (mirrorX >= 1f)), select(mirrorY, (2f - mirrorY), (mirrorY >= 1f)));
}

fn legacySinHash11(x: f32) -> f32 {
