// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ChromaticAberration (a) RTT multi-offset filter path > RTTs the child, samples 3 offset UVs, recombines channels, unpremultiplies > final-pass 1`] = `
"fn unpremultiplyAlpha(color2: vec4f) -> vec4f {
  let alpha = color2.w;
  let straightRGB = select(vec3f(), (color2.xyz / alpha), (alpha > 1e-3f));
  return vec4f(straightRGB, alpha);
}

@group(1) @binding(0) var rtt_0: texture_2d<f32>;

@group(2) @binding(0) var linearClamp: sampler;

fn chromaticOffsetUV(uv: vec2f, angle: f32, strength: f32, aspect: f32, channelOffset: f32) -> vec2f {
  let angleRad = radians(angle);
  let direction = vec2f((cos(angleRad) / aspect), sin(angleRad));
  let scaledStrength = (strength * 0.1f);
  let offsetBase = (direction * scaledStrength);
  return (uv + (offsetBase * channelOffset));
}

struct padded {
  _opacity: f32,
  _pad0: f32,
  _pad1: f32,
  _pad2: f32,
}

struct padded_1 {
  strength: f32,
  angle: f32,
  redOffset: f32,
  greenOffset: f32,
  blueOffset: f32,
  _opacity: f32,
  _pad0: f32,
  _pad1: f32,
}

struct padded_2 {
  _opacity: f32,
  _pad0: f32,
  _pad1: f32,
  _pad2: f32,
}

struct struct_1 {
  time: f32,
  viewportSize: vec2f,
  logicalViewportSize: vec2f,
  aspect: f32,
  pointer: vec2f,
  pointerActive: f32,
}

struct combined {
  n_root: padded,
  n_ca: padded_1,
  n_gen: padded_2,
  _sys: struct_1,
}

@group(0) @binding(0) var<uniform> uniforms: combined;

fn linearToSrgb(color: vec3f) -> vec3f {
  let a = ((pow(color, vec3f(0.41666001081466675)) * 1.055f) - 0.055f);
  let b = (color * 12.92f);
  let factor = (color <= vec3f(0.0031308000907301903));
  return select(a, b, factor);
}

fn tone_linear(color: vec3f) -> vec3f {
  return vec3f(color.x, color.y, color.z);
}

struct final_Input {
  @location(0) uv: vec2f,
}

@fragment fn final_1(in: final_Input) -> @location(0)  vec4f {
  var uv = vec2f(in.uv.x, 1.0 - in.uv.y);
  var composed_0 = unpremultiplyAlpha(vec4f((textureSample(rtt_0, linearClamp, chromaticOffsetUV(uv, uniforms.n_ca.angle, uniforms.n_ca.strength, uniforms._sys.aspect, uniforms.n_ca.redOffset))).r, (textureSample(rtt_0, linearClamp, chromaticOffsetUV(uv, uniforms.n_ca.angle, uniforms.n_ca.strength, uniforms._sys.aspect, uniforms.n_ca.greenOffset))).g, (textureSample(rtt_0, linearClamp, chromaticOffsetUV(uv, uniforms.n_ca.angle, uniforms.n_ca.strength, uniforms._sys.aspect, uniforms.n_ca.blueOffset))).b, (textureSample(rtt_0, linearClamp, chromaticOffsetUV(uv, uniforms.n_ca.angle, uniforms.n_ca.strength, uniforms._sys.aspect, uniforms.n_ca.greenOffset))).a));
  return vec4f(linearToSrgb(tone_linear(composed_0.rgb)), composed_0.a);
}"
`;
