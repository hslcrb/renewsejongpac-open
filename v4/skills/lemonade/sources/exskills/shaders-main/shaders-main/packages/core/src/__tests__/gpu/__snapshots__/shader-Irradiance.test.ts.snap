  body_33 = (1.0 - exp((-(((uniforms.n_i.bodyColor.rgb * 0.3) + bodySum_38)))));
}
  let cov_45 = silhouetteAlpha(sdf_6, uniforms.n_i.edgeSoftness, pxUV_4);
