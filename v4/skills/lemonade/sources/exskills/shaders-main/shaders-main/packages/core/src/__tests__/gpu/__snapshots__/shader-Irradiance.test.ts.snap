  let rimS0_12 = analyticSdf_circleSDF(sdfUV_8, uniforms.n_i._saRadius, uniforms.n_i._saSides, uniforms.n_i._saRounding, uniforms.n_i._saInnerRatio, uniforms.n_i._saRotation, uniforms.n_i._saHeight, uniforms.n_i._saOffset, uniforms.n_i._saAperture);
