  let lightUV_19 = sdfSpaceUV(uniforms.n_i.center, uniforms.n_i.scale, uniforms.n_i.rotation, vec2f(((uniforms.n_i.lights_position[item_16]).xy).x, (1.0 - ((uniforms.n_i.lights_position[item_16]).xy).y)), uniforms._sys.aspect);
  let rimLightD_18 = (lightUV_19 - edgeP_9);
