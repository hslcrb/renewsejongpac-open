  rimSum_15 += (((uniforms.n_i.lights_color[item_16]).rgb * (uniforms.n_i.lights_intensity[item_16]).x) * ((clamp(((dot(edgeN_10, rimLightDir_17) + uniforms.n_i.wrap) / (1.0 + uniforms.n_i.wrap)), 0.0, 1.0) * (1.0 / (1.0 + ((rimLightDist_20 / uniforms.n_i.lightRange) * (rimLightDist_20 / uniforms.n_i.lightRange))))) * rimVisibility_21));
