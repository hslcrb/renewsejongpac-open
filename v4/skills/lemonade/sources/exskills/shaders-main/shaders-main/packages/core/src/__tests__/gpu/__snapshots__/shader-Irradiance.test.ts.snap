  let glow_0 = (1.0 - exp((-(((irrTex_1.rgb / max(irrTex_1.a, 0.001)) + emitter_2)))));
  let glowA_32 = clamp(max(max(glow_0.x, glow_0.y), glow_0.z), 0.0, 1.0);
  var body_33 = vec3f(0.0);
  if ((!(outsideShape(sdf_6, pxUV_4)))) {
  let bodyS0_35 = analyticSdf_circleSDF(sdfUV_8, uniforms.n_i._saRadius, uniforms.n_i._saSides, uniforms.n_i._saRounding, uniforms.n_i._saInnerRatio, uniforms.n_i._saRotation, uniforms.n_i._saHeight, uniforms.n_i._saOffset, uniforms.n_i._saAperture);
  let bodyX_36 = analyticSdf_circleSDF((sdfUV_8 + vec2f(0.01, 0.0)), uniforms.n_i._saRadius, uniforms.n_i._saSides, uniforms.n_i._saRounding, uniforms.n_i._saInnerRatio, uniforms.n_i._saRotation, uniforms.n_i._saHeight, uniforms.n_i._saOffset, uniforms.n_i._saAperture);
  let bodyY_37 = analyticSdf_circleSDF((sdfUV_8 + vec2f(0.0, 0.01)), uniforms.n_i._saRadius, uniforms.n_i._saSides, uniforms.n_i._saRounding, uniforms.n_i._saInnerRatio, uniforms.n_i._saRotation, uniforms.n_i._saHeight, uniforms.n_i._saOffset, uniforms.n_i._saAperture);
  let nGeo_34 = bevelledFlatNormal(fieldGradient(bodyS0_35, bodyX_36, bodyY_37, 0.01), bevelSin(clamp(((-(sdf_6)) / max(uniforms.n_i.bevelWidth, 0.003)), 0.0, 1.0), 0.0));
  var bodySum_38 = vec3f(0.0);
  for (var item_39 = 0u; item_39 < u32(uniforms.n_i.lightsCount); item_39++) {
  let lightUV_42 = sdfSpaceUV(uniforms.n_i.center, uniforms.n_i.scale, uniforms.n_i.rotation, vec2f(((uniforms.n_i.lights_position[item_39]).xy).x, (1.0 - ((uniforms.n_i.lights_position[item_39]).xy).y)), uniforms._sys.aspect);
  let bodyLightD_41 = (lightUV_42 - sdfUV_8);
  let bodyLightL_40 = normalize(vec3f(bodyLightD_41.x, bodyLightD_41.y, (-(uniforms.n_i.lightHeight))));
