// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ContourLines (a) shipped-v1 replace over a preceding sibling (blendWithChildren:false parity) > REPLACES the sibling composition (shipped v1 parity; luminance default) > contourlines-over-sibling 1`] = `
"fn genBody(seed: f32, uv: vec2f) -> vec4f {
  return vec4f(uv.x, uv.y, seed, 1f);
}

struct padded {
  _opacity: f32,
  _pad0: f32,
  _pad1: f32,
  _pad2: f32,
}

struct padded_1 {
  seed: f32,
  _opacity: f32,
  _pad0: f32,
  _pad1: f32,
}

struct struct_1 {
  levels: f32,
  lineWidth: f32,
  softness: f32,
  gamma: f32,
  invert: f32,
  source: f32,
  colorMode: f32,
  lineColor: vec4f,
  backgroundColor: vec4f,
  _opacity: f32,
}

struct struct_2 {
  time: f32,
  viewportSize: vec2f,
  logicalViewportSize: vec2f,
  aspect: f32,
  pointer: vec2f,
  pointerActive: f32,
}

struct combined {
  n_root: padded,
  n_gen: padded_1,
  n_cl: struct_1,
  _sys: struct_2,
}

@group(0) @binding(0) var<uniform> uniforms: combined;

fn contourCompose(bg: vec4f, line: vec4f, mask: f32) -> vec4f {
  let rgb = mix(vec3f(bg.x, bg.y, bg.z), vec3f(line.x, line.y, line.z), vec3f(mask));
  let alpha = mix(bg.w, line.w, mask);
  return vec4f(rgb.x, rgb.y, rgb.z, alpha);
}

fn luma709Dot(rgb: vec3f) -> f32 {
  return dot(rgb, vec3f(0.2125999927520752, 0.7152000069618225, 0.0722000002861023));
}

fn contourLineMask(sourceValue: f32, levels: f32, lineWidth: f32, softness: f32, gamma: f32, invert2: f32) -> f32 {
  let invertedValue = select(sourceValue, (1f - sourceValue), (invert2 > 0.5f));
  let sv = pow(invertedValue, gamma);
  let scaledValue = ((sv * levels) + 0.5f);
  let fw = max(fwidth(scaledValue), 1e-4f);
  let distFromBoundary = abs((fract((scaledValue + 0.5f)) - 0.5f));
  let normalizedDist = (distFromBoundary / fw);
  let transitionFactor = ((softness * 0.99f) + 0.01f);
  let innerEdge = (lineWidth * (1f - transitionFactor));
  return (1f - smoothstep(innerEdge, lineWidth, normalizedDist));
}

fn isolinesFromLuma(color: vec4f, levels: f32, lineWidth: f32, softness: f32, gamma: f32, invert2: f32) -> f32 {
  return contourLineMask(luma709Dot(color.xyz), levels, lineWidth, softness, gamma, invert2);
}

fn linearToSrgb(color: vec3f) -> vec3f {
  let a = ((pow(color, vec3f(0.41666001081466675)) * 1.055f) - 0.055f);
  let b = (color * 12.92f);
  let factor = (color <= vec3f(0.0031308000907301903));
  return select(a, b, factor);
}

fn tone_linear(color: vec3f) -> vec3f {
  return vec3f(color.x, color.y, color.z);
}

struct final_Input {
  @location(0) uv: vec2f,
}

@fragment fn final_1(in: final_Input) -> @location(0)  vec4f {
  var uv = vec2f(in.uv.x, 1.0 - in.uv.y);
  var composed_0 = mix(genBody(uniforms.n_gen.seed, uv), contourCompose(vec4f(0.0, 0.0, 0.0, 0.0), vec4f((genBody(uniforms.n_gen.seed, uv)).rgb, 1.0), isolinesFromLuma(genBody(uniforms.n_gen.seed, uv), uniforms.n_cl.levels, uniforms.n_cl.lineWidth, uniforms.n_cl.softness, uniforms.n_cl.gamma, uniforms.n_cl.invert)), uniforms.n_cl._opacity);
  return vec4f(linearToSrgb(tone_linear(composed_0.rgb)), composed_0.a);
}"
`;
