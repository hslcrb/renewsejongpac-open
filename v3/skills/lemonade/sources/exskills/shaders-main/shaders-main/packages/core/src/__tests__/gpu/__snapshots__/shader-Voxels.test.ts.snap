exports[`Voxels (b) compile-time variants > sphere voxels on the screen grid with the random palette resolve (no matrix rotation of the hit) > sphere-view-random 1`] = `
"fn sdfSpaceUV(center: vec2f, scale: f32, rotation: f32, uv: vec2f, aspect: f32) -> vec2f {
  let centerX = center.x;
