@group(0) @binding(0) var<uniform> uniforms: combined;

fn genBody(uv: vec2f) -> vec4f {
  return vec4f(uv.x, uv.y, 0.5f, 1f);
}

fn unpremultiplyAlpha(color2: vec4f) -> vec4f {
  let alpha = color2.w;
  let straightRGB = select(vec3f(), (color2.xyz / alpha), (alpha > 1e-3f));
  return vec4f(straightRGB, alpha);
}

@group(1) @binding(0) var rtt_0: texture_2d<f32>;

@group(2) @binding(0) var linearClamp: sampler;

fn edgeMirrorUV(uv: vec2f) -> vec2f {
  let mirrorX = (abs(uv.x) % 2f);
  let mirrorY = (abs(uv.y) % 2f);
  return vec2f(select(mirrorX, (2f - mirrorX), (mirrorX >= 1f)), select(mirrorY, (2f - mirrorY), (mirrorY >= 1f)));
}

fn blinnHighlight(slope: f32, lightAngleDeg: f32, intensity: f32, softness: f32) -> f32 {
  let slopeSq = min((slope * slope), 1f);
  let nz = sqrt((1f - slopeSq));
  let half = ((lightAngleDeg * 3.141592653589793f) / 360f);
  let hx = sin(half);
  let hy = cos(half);
  let nDotH = max(((slope * hx) + (nz * hy)), 0f);
  let shininess = exp2((8f - (softness * 7f)));
  let fresnel = pow((1f - nz), 5f);
  let fresnelMix = (0.04f + (0.96f * fresnel));
  return ((pow(nDotH, shininess) * fresnelMix) * intensity);
}

fn linearToSrgb(color: vec3f) -> vec3f {
  let a = ((pow(color, vec3f(0.41666001081466675)) * 1.055f) - 0.055f);
  let b = (color * 12.92f);
  let factor = (color <= vec3f(0.0031308000907301903));
  return select(a, b, factor);
}

fn tone_linear(color: vec3f) -> vec3f {
  return vec3f(color.x, color.y, color.z);
}

struct final_Input {
  @location(0) uv: vec2f,
}

@fragment fn final_1(in: final_Input) -> @location(0)  vec4f {
  var uv = vec2f(in.uv.x, 1.0 - in.uv.y);
  let flute_0 = flutedGlassGeom(uv, uniforms._sys.aspect, (uniforms.n_fg._animTime * -1.0), uniforms.n_fg.angle, uniforms.n_fg.frequency, uniforms.n_fg.softness, uniforms.n_fg.waveAmplitude, uniforms.n_fg.waveFrequency, uniforms.n_fg.refraction, uniforms.n_fg.aberration, vec3f(16.0, 4.0, 0.0));
  var composed_1 = mix(genBody(uv), vec4f(((unpremultiplyAlpha(vec4f((textureSample(rtt_0, linearClamp, edgeMirrorUV((flute_0.refractedUV + flute_0.chrOff)))).r, (textureSample(rtt_0, linearClamp, edgeMirrorUV(flute_0.refractedUV))).g, (textureSample(rtt_0, linearClamp, edgeMirrorUV((flute_0.refractedUV + (flute_0.chrOff * -1.0))))).b, (textureSample(rtt_0, linearClamp, edgeMirrorUV(flute_0.refractedUV))).a))).rgb + (uniforms.n_fg.highlightColor.rgb * (blinnHighlight(flute_0.slope, uniforms.n_fg.lightAngle, uniforms.n_fg.highlight, uniforms.n_fg.highlightSoftness) * (unpremultiplyAlpha(vec4f((textureSample(rtt_0, linearClamp, edgeMirrorUV((flute_0.refractedUV + flute_0.chrOff)))).r, (textureSample(rtt_0, linearClamp, edgeMirrorUV(flute_0.refractedUV))).g, (textureSample(rtt_0, linearClamp, edgeMirrorUV((flute_0.refractedUV + (flute_0.chrOff * -1.0))))).b, (textureSample(rtt_0, linearClamp, edgeMirrorUV(flute_0.refractedUV))).a))).a))), (unpremultiplyAlpha(vec4f((textureSample(rtt_0, linearClamp, edgeMirrorUV((flute_0.refractedUV + flute_0.chrOff)))).r, (textureSample(rtt_0, linearClamp, edgeMirrorUV(flute_0.refractedUV))).g, (textureSample(rtt_0, linearClamp, edgeMirrorUV((flute_0.refractedUV + (flute_0.chrOff * -1.0))))).b, (textureSample(rtt_0, linearClamp, edgeMirrorUV(flute_0.refractedUV))).a))).a), uniforms.n_fg._opacity);
  return vec4f(linearToSrgb(tone_linear(composed_1.rgb)), composed_1.a);
}"
`;

exports[`Godrays (animated generator) > reads _animTime and emits the ray field + composite > godrays 1`] = `
"fn coverageOver(rayColor: vec4f, bgColor: vec4f, coverage: f32) -> vec4f {
  let rayA = (coverage * rayColor.w);
  let finalAlpha = (rayA + (bgColor.w * (1f - rayA)));
  let safeAlpha = clamp(finalAlpha, 1e-3f, 1f);
  let rayContribution = (rayColor.xyz * rayA);
  let bgContribution = ((bgColor.xyz * bgColor.w) * (1f - rayA));
  let finalColor = ((rayContribution + bgContribution) / safeAlpha);
  return vec4f(finalColor, finalAlpha);
}

struct struct_1 {
  center: vec2f,
  density: f32,
  intensity: f32,
  spotty: f32,
  speed: f32,
  rayColor: vec4f,
  backgroundColor: vec4f,
  _opacity: f32,
  _animTime: f32,
}

struct struct_2 {
  time: f32,
  viewportSize: vec2f,
  logicalViewportSize: vec2f,
  aspect: f32,
  pointer: vec2f,
  pointerActive: f32,
}

struct combined {
  n_n: struct_1,
  _sys: struct_2,
