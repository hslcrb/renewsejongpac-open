// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Tritone (a) inline color-filter path (NO RTT) > three-tone map by luminance inline — no RTT, no unpremultiply > final-pass 1`] = `
"fn awMix(a: vec3f, b: vec3f, wA: f32, wB: f32, sw: f32) -> vec3f {
  return (((a * wA) + (b * wB)) / sw);
}

fn mixColors(colorA: vec4f, colorB: vec4f, t: f32) -> vec4f {
  let weightA = (colorA.w * (1f - t));
  let weightB = (colorB.w * t);
  let totalWeight = (weightA + weightB);
  let safeWeight = max(totalWeight, 1e-3f);
  let rgb = awMix(colorA.xyz, colorB.xyz, weightA, weightB, safeWeight);
  return vec4f(rgb, totalWeight);
}

struct padded {
  _opacity: f32,
  _pad0: f32,
  _pad1: f32,
  _pad2: f32,
}

struct struct_1 {
  colorA: vec4f,
  colorB: vec4f,
  colorC: vec4f,
  blendMid: f32,
  colorSpace: f32,
  _opacity: f32,
}

struct padded_1 {
  _opacity: f32,
  _pad0: f32,
  _pad1: f32,
  _pad2: f32,
}

struct struct_2 {
  time: f32,
  viewportSize: vec2f,
  logicalViewportSize: vec2f,
  aspect: f32,
  pointer: vec2f,
  pointerActive: f32,
}

struct combined {
  n_root: padded,
  n_tri: struct_1,
  n_gen: padded_1,
  _sys: struct_2,
}

@group(0) @binding(0) var<uniform> uniforms: combined;

fn tritoneFactors(color: vec4f, blendMid: f32) -> vec3f {
  let luminance = dot(color.xyz, vec3f(0.29899999499320984, 0.5870000123977661, 0.11400000005960464));
  let shadowToMid = smoothstep((blendMid - 0.25f), blendMid, luminance);
  let midToHighlight = smoothstep(blendMid, (blendMid + 0.25f), luminance);
  let finalT = smoothstep((blendMid - 0.1f), (blendMid + 0.1f), luminance);
  return vec3f(shadowToMid, midToHighlight, finalT);
}

fn genBody(uv: vec2f) -> vec4f {
  return vec4f(uv.x, uv.y, 0.5f, 1f);
}

fn linearToSrgb(color: vec3f) -> vec3f {
  let a = ((pow(color, vec3f(0.41666001081466675)) * 1.055f) - 0.055f);
  let b = (color * 12.92f);
  let factor = (color <= vec3f(0.0031308000907301903));
  return select(a, b, factor);
}

fn tone_linear(color: vec3f) -> vec3f {
  return vec3f(color.x, color.y, color.z);
}

struct final_Input {
  @location(0) uv: vec2f,
}

@fragment fn final_1(in: final_Input) -> @location(0)  vec4f {
  var uv = vec2f(in.uv.x, 1.0 - in.uv.y);
  var composed_0 = vec4f((mixColors(mixColors(uniforms.n_tri.colorA, uniforms.n_tri.colorB, (tritoneFactors(genBody(uv), uniforms.n_tri.blendMid)).x), mixColors(uniforms.n_tri.colorB, uniforms.n_tri.colorC, (tritoneFactors(genBody(uv), uniforms.n_tri.blendMid)).y), (tritoneFactors(genBody(uv), uniforms.n_tri.blendMid)).z)).rgb, (genBody(uv)).a);
  return vec4f(linearToSrgb(tone_linear(composed_0.rgb)), composed_0.a);
}"
`;
