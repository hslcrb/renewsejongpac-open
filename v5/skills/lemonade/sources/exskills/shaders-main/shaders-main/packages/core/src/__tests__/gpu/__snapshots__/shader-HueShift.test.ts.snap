// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`HueShift (a) shift=0 identity bypass > passes the child through unchanged — no rotation matrix, no RTT > identity-final-pass 1`] = `
"fn genBody(uv: vec2f) -> vec4f {
  return vec4f(uv.x, uv.y, 0.5f, 1f);
}

fn linearToSrgb(color: vec3f) -> vec3f {
  let a = ((pow(color, vec3f(0.41666001081466675)) * 1.055f) - 0.055f);
  let b = (color * 12.92f);
  let factor = (color <= vec3f(0.0031308000907301903));
  return select(a, b, factor);
}

fn tone_linear(color: vec3f) -> vec3f {
  return vec3f(color.x, color.y, color.z);
}

struct final_Input {
  @location(0) uv: vec2f,
}

@fragment fn final_1(in: final_Input) -> @location(0)  vec4f {
  var uv = vec2f(in.uv.x, 1.0 - in.uv.y);
  var composed_0 = genBody(uv);
  return vec4f(linearToSrgb(tone_linear(composed_0.rgb)), composed_0.a);
}"
`;

exports[`HueShift (b) shift≠0 rotation path > emits the hue-rotation body over the composed child inline > rotation-final-pass 1`] = `
"fn hueRotate(color: vec4f, shiftDeg: f32) -> vec4f {
  let angle = (shiftDeg * 0.017453292519943295f);
  let cosA = cos(angle);
  let sinA = sin(angle);
  const k = 0.3333333333333333;
  let oneMinusCos = (1f - cosA);
  let kOneMinusCos = (oneMinusCos * k);
  let sinOverSqrt3 = (sinA / 1.7320508075688772f);
  let m00 = (cosA + kOneMinusCos);
  let m01 = (kOneMinusCos - sinOverSqrt3);
  let m02 = (kOneMinusCos + sinOverSqrt3);
  let m10 = (kOneMinusCos + sinOverSqrt3);
  let m11 = (cosA + kOneMinusCos);
  let m12 = (kOneMinusCos - sinOverSqrt3);
  let m20 = (kOneMinusCos - sinOverSqrt3);
  let m21 = (kOneMinusCos + sinOverSqrt3);
  let m22 = (cosA + kOneMinusCos);
  let r = color.x;
  let g = color.y;
  let b = color.z;
  let newR = (((r * m00) + (g * m01)) + (b * m02));
  let newG = (((r * m10) + (g * m11)) + (b * m12));
  let newB = (((r * m20) + (g * m21)) + (b * m22));
  return vec4f(newR, newG, newB, color.w);
}

fn genBody(uv: vec2f) -> vec4f {
  return vec4f(uv.x, uv.y, 0.5f, 1f);
}

struct padded {
  _opacity: f32,
  _pad0: f32,
  _pad1: f32,
  _pad2: f32,
}

struct padded_1 {
  shift: f32,
  _opacity: f32,
  _pad0: f32,
  _pad1: f32,
}

struct padded_2 {
  _opacity: f32,
  _pad0: f32,
  _pad1: f32,
  _pad2: f32,
}

struct struct_1 {
  time: f32,
  viewportSize: vec2f,
  logicalViewportSize: vec2f,
  aspect: f32,
  pointer: vec2f,
  pointerActive: f32,
}

struct combined {
  n_root: padded,
  n_hs: padded_1,
  n_gen: padded_2,
  _sys: struct_1,
}

@group(0) @binding(0) var<uniform> uniforms: combined;

fn linearToSrgb(color: vec3f) -> vec3f {
  let a = ((pow(color, vec3f(0.41666001081466675)) * 1.055f) - 0.055f);
  let b = (color * 12.92f);
  let factor = (color <= vec3f(0.0031308000907301903));
  return select(a, b, factor);
}

fn tone_linear(color: vec3f) -> vec3f {
  return vec3f(color.x, color.y, color.z);
}

struct final_Input {
  @location(0) uv: vec2f,
}

@fragment fn final_1(in: final_Input) -> @location(0)  vec4f {
  var uv = vec2f(in.uv.x, 1.0 - in.uv.y);
  var composed_0 = hueRotate(genBody(uv), uniforms.n_hs.shift);
  return vec4f(linearToSrgb(tone_linear(composed_0.rgb)), composed_0.a);
}"
`;
