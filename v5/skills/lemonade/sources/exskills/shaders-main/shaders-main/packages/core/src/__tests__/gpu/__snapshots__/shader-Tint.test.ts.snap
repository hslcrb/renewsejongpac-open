// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Tint (a) compile-time preserveLuminosity branch > default (preserve=true): emits tintPreserveLuma, no RTT/unpremultiply > final-pass-preserve 1`] = `
"fn tintPreserveLuma(color: vec4f, tintColor: vec4f, amount: f32) -> vec4f {
  let rgb = vec3f(color.x, color.y, color.z);
  let tinted = mix(rgb, vec3f(tintColor.x, tintColor.y, tintColor.z), vec3f(amount));
  let luminanceWeights = vec3f(0.29899999499320984, 0.5870000123977661, 0.11400000005960464);
  let originalLum = dot(rgb, luminanceWeights);
  let tintedLum = dot(tinted, luminanceWeights);
  let result = (tinted * (originalLum / max(tintedLum, 1e-4f)));
  return vec4f(result.x, result.y, result.z, color.w);
}

fn genBody(uv: vec2f) -> vec4f {
  return vec4f(uv.x, uv.y, 0.5f, 1f);
}

struct padded {
  _opacity: f32,
  _pad0: f32,
  _pad1: f32,
  _pad2: f32,
}

struct struct_1 {
  color: vec4f,
  amount: f32,
  preserveLuminosity: f32,
  _opacity: f32,
}

struct padded_1 {
  _opacity: f32,
  _pad0: f32,
  _pad1: f32,
  _pad2: f32,
}

struct struct_2 {
  time: f32,
  viewportSize: vec2f,
  logicalViewportSize: vec2f,
  aspect: f32,
  pointer: vec2f,
  pointerActive: f32,
}

struct combined {
  n_root: padded,
  n_t: struct_1,
  n_gen: padded_1,
  _sys: struct_2,
}

@group(0) @binding(0) var<uniform> uniforms: combined;

fn linearToSrgb(color: vec3f) -> vec3f {
  let a = ((pow(color, vec3f(0.41666001081466675)) * 1.055f) - 0.055f);
  let b = (color * 12.92f);
  let factor = (color <= vec3f(0.0031308000907301903));
  return select(a, b, factor);
}

fn tone_linear(color: vec3f) -> vec3f {
  return vec3f(color.x, color.y, color.z);
}

struct final_Input {
  @location(0) uv: vec2f,
}

@fragment fn final_1(in: final_Input) -> @location(0)  vec4f {
  var uv = vec2f(in.uv.x, 1.0 - in.uv.y);
  var composed_0 = tintPreserveLuma(genBody(uv), uniforms.n_t.color, uniforms.n_t.amount);
  return vec4f(linearToSrgb(tone_linear(composed_0.rgb)), composed_0.a);
}"
`;
