  alphaAlong: f32,
  alphaAcross: f32,
}

fn wardAnisotropicSpecular(p: WardSpecularInput) -> f32 {
  let frame = orthonormalTangentFrame(p.normal, p.tangent);
  let H = normalize((p.light - p.view));
  let hT = dot(H, frame.tangent);
  let hB = dot(H, frame.bitangent);
