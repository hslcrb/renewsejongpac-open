@fragment fn final_1(in: final_Input) -> @location(0)  vec4f {
  var uv = vec2f(in.uv.x, 1.0 - in.uv.y);
  var composed_0 = mediaAlphaCut(textureSampleBaseClampToEdge(video_0, linearClamp, applyMirror(mediaSampleUV(uv, scaleCover(vec2f(textureDimensions(video_0)), uniforms._sys.viewportSize)), uniforms.n_cam.mirror)), applyMirror(mediaSampleUV(uv, scaleCover(vec2f(textureDimensions(video_0)), uniforms._sys.viewportSize)), uniforms.n_cam.mirror));
  return vec4f(linearToSrgb(tone_linear(composed_0.rgb)), composed_0.a);
