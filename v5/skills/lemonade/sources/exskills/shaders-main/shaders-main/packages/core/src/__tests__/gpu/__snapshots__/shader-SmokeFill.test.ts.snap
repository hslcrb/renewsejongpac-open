exports[`SmokeFill (a) shape-confined fluid → SDF-masked fragment > registers a compute texture; ordered dispatch = mask + fluid (21 steps); fragment masks by SDF > final-pass 1`] = `
"fn awMix(a: vec3f, b: vec3f, wA: f32, wB: f32, sw: f32) -> vec3f {
  return (((a * wA) + (b * wB)) / sw);
}

fn mixColors(colorA: vec4f, colorB: vec4f, t: f32) -> vec4f {
  let weightA = (colorA.w * (1f - t));
  let weightB = (colorB.w * t);
  let totalWeight = (weightA + weightB);
  let safeWeight = max(totalWeight, 1e-3f);
  let rgb = awMix(colorA.xyz, colorB.xyz, weightA, weightB, safeWeight);
  return vec4f(rgb, totalWeight);
}

struct padded {
  _opacity: f32,
  _pad0: f32,
  _pad1: f32,
  _pad2: f32,
}

struct struct_1 {
  colorA: vec4f,
  colorB: vec4f,
  center: vec2f,
  scale: f32,
  rotation: f32,
  emitFrom: vec2f,
  direction: f32,
  speed: f32,
  spread: f32,
  emitRadius: f32,
  intensity: f32,
  dissipation: f32,
  detail: f32,
