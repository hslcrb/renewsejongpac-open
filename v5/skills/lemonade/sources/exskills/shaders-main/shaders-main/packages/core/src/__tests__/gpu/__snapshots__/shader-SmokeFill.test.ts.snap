  _opacity: f32,
}

struct struct_2 {
  time: f32,
  viewportSize: vec2f,
  logicalViewportSize: vec2f,
  aspect: f32,
  pointer: vec2f,
  pointerActive: f32,
}

struct combined {
  n_root: padded,
  n_sf: struct_1,
  _sys: struct_2,
}

@group(0) @binding(0) var<uniform> uniforms: combined;

@group(1) @binding(0) var compute_0: texture_2d<f32>;

@group(2) @binding(0) var linearClamp: sampler;

fn circleSdf(dx: f32, dy: f32, radius: f32) -> f32 {
  return (sqrt(((dx * dx) + (dy * dy))) - radius);
}

fn analyticSdf_circleSDF(uv: vec2f, r: f32, n: f32, round_1: f32, inner: f32, rot: f32, h: f32, off: f32, ap: f32) -> vec4f {
  let dx = (uv.x - 0.5f);
  let dy = (uv.y - 0.5f);
  let rotRad = (rot * 0.017453292519943295f);
  let cosR = cos(rotRad);
  let sinR = sin(rotRad);
  let rdx = ((dx * cosR) + (dy * sinR));
  let rdy = ((dy * cosR) - (dx * sinR));
  var dist = 0f;
  dist = circleSdf(rdx, rdy, r);
  return vec4f(dist, 0f, 0f, 1f);
}

fn sdfSpaceUV(center: vec2f, scale: f32, rotation: f32, uv: vec2f, aspect: f32) -> vec2f {
  let centerX = center.x;
  let centerY = (1f - center.y);
  let dxAc = ((uv.x - centerX) * aspect);
  let dy = (uv.y - centerY);
  let rotRad = (rotation * 0.017453292519943295f);
  let cosR = cos(rotRad);
  let sinR = sin(rotRad);
  let rdx = ((dxAc * cosR) + (dy * sinR));
  let rdy = ((dy * cosR) - (dxAc * sinR));
  return vec2f(((rdx / scale) + 0.5f), ((rdy / scale) + 0.5f));
}

fn linearToSrgb(color: vec3f) -> vec3f {
  let a = ((pow(color, vec3f(0.41666001081466675)) * 1.055f) - 0.055f);
  let b = (color * 12.92f);
  let factor = (color <= vec3f(0.0031308000907301903));
  return select(a, b, factor);
}

fn tone_linear(color: vec3f) -> vec3f {
  return vec3f(color.x, color.y, color.z);
}

struct final_Input {
  @location(0) uv: vec2f,
}

@fragment fn final_1(in: final_Input) -> @location(0)  vec4f {
  var uv = in.uv;
  var composed_0 = vec4f((mixColors(uniforms.n_sf.colorA, uniforms.n_sf.colorB, (textureSample(compute_0, linearClamp, uv)).y)).rgb, (((mixColors(uniforms.n_sf.colorA, uniforms.n_sf.colorB, (textureSample(compute_0, linearClamp, uv)).y)).a * (textureSample(compute_0, linearClamp, uv)).x) * clamp(((analyticSdf_circleSDF(sdfSpaceUV(uniforms.n_sf.center, uniforms.n_sf.scale, uniforms.n_sf.rotation, uv, uniforms._sys.aspect), uniforms.n_sf._saRadius, uniforms.n_sf._saSides, uniforms.n_sf._saRounding, uniforms.n_sf._saInnerRatio, uniforms.n_sf._saRotation, uniforms.n_sf._saHeight, uniforms.n_sf._saOffset, uniforms.n_sf._saAperture)).x * -1024.0), 0.0, 1.0)));
  return vec4f(linearToSrgb(tone_linear(composed_0.rgb)), composed_0.a);
}"
