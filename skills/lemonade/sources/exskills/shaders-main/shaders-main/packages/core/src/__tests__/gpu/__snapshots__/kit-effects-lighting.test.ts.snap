  let dhx = ((hR - hL) / (eps * 2f));
  let dhy = ((hU - hD) / (eps * 2f));
  let nLen = sqrt((((dhx * dhx) + (dhy * dhy)) + 1f));
  let nx = ((dhx * -1f) / nLen);
  let ny = ((dhy * -1f) / nLen);
  let nz = (1f / nLen);
  let lx = cos((lightAngle * 0.017453292519943295f));
  let ly = sin((lightAngle * 0.017453292519943295f));
