exports[`noise resolve gate — perlin + worley emit valid WGSL > matches WGSL snapshot 1`] = `
"fn mxFade(t: f32) -> f32 {
  return (((t * t) * t) * ((t * ((t * 6f) - 15f)) + 10f));
}

fn mxRotl32(x: u32, k: i32) -> u32 {
  return ((x << u32(k)) | (x >> u32((32i - k))));
}

fn mxBjfinal(a0: u32, b0: u32, c0: u32) -> u32 {
  var a = a0;
  var b = b0;
  var c = c0;
  c = (c ^ b);
  c = (c - mxRotl32(b, 14i));
  a = (a ^ c);
  a = (a - mxRotl32(c, 11i));
  b = (b ^ a);
  b = (b - mxRotl32(a, 25i));
  c = (c ^ b);
  c = (c - mxRotl32(b, 16i));
  a = (a ^ c);
  a = (a - mxRotl32(c, 4i));
  b = (b ^ a);
  b = (b - mxRotl32(a, 14i));
  c = (c ^ b);
  c = (c - mxRotl32(b, 24i));
  return c;
}

fn mxHashInt1(x: i32, y: i32) -> u32 {
  const len = 2u;
  let seed = ((3735928559u + (len << 2u)) + 13u);
  let a = (seed + u32(x));
  let b = (seed + u32(y));
  return mxBjfinal(a, b, seed);
}

fn mxGradientFloat2(hash: u32, x: f32, y: f32) -> f32 {
  let h = (hash & 7u);
  let u = select(y, x, (h < 4u));
  let v = (2f * select(x, y, (h < 4u)));
  let uu = select(u, -(u), ((h & 1u) != 0u));
  let vv = select(v, -(v), ((h & 2u) != 0u));
  return (uu + vv);
}

fn mxBilerp(v0: f32, v1: f32, v2: f32, v3: f32, s: f32, t: f32) -> f32 {
  let s1 = (1f - s);
  return (((1f - t) * ((v0 * s1) + (v1 * s))) + (t * ((v2 * s1) + (v3 * s))));
}

fn mxGradientScale2d(v: f32) -> f32 {
  return (0.6616f * v);
}

fn mxPerlinNoiseFloat2(p: vec2f) -> f32 {
  let X = i32(floor(p.x));
  let Y = i32(floor(p.y));
  let fx = (p.x - f32(X));
  let fy = (p.y - f32(Y));
  let u = mxFade(fx);
  let v = mxFade(fy);
  let result = mxBilerp(mxGradientFloat2(mxHashInt1(X, Y), fx, fy), mxGradientFloat2(mxHashInt1((X + 1i), Y), (fx - 1f), fy), mxGradientFloat2(mxHashInt1(X, (Y + 1i)), fx, (fy - 1f)), mxGradientFloat2(mxHashInt1((X + 1i), (Y + 1i)), (fx - 1f), (fy - 1f)), u, v);
  return mxGradientScale2d(result);
}

fn mxNoiseFloat2(p: vec2f) -> f32 {
  return mxPerlinNoiseFloat2(p);
}

fn mxHashInt2(x: i32, y: i32, z: i32) -> u32 {
  const len = 3u;
  let seed = ((3735928559u + (len << 2u)) + 13u);
  let a = (seed + u32(x));
  let b = (seed + u32(y));
  let c = (seed + u32(z));
  return mxBjfinal(a, b, c);
}

fn mxGradientFloat3(hash: u32, x: f32, y: f32, z: f32) -> f32 {
  let h = (hash & 15u);
  let u = select(y, x, (h < 8u));
  let inner = select(z, x, ((h == 12u) || (h == 14u)));
  let v = select(inner, y, (h < 4u));
  let uu = select(u, -(u), ((h & 1u) != 0u));
  let vv = select(v, -(v), ((h & 2u) != 0u));
  return (uu + vv);
}

fn mxTrilerp(v0: f32, v1: f32, v2: f32, v3: f32, v4: f32, v5: f32, v6: f32, v7: f32, s: f32, t: f32, r: f32) -> f32 {
  let s1 = (1f - s);
  let t1 = (1f - t);
  let r1 = (1f - r);
  return ((r1 * ((t1 * ((v0 * s1) + (v1 * s))) + (t * ((v2 * s1) + (v3 * s))))) + (r * ((t1 * ((v4 * s1) + (v5 * s))) + (t * ((v6 * s1) + (v7 * s))))));
}

fn mxGradientScale3d(v: f32) -> f32 {
  return (0.982f * v);
}

fn mxPerlinNoiseFloat3(p: vec3f) -> f32 {
  let X = i32(floor(p.x));
  let Y = i32(floor(p.y));
  let Z = i32(floor(p.z));
  let fx = (p.x - f32(X));
  let fy = (p.y - f32(Y));
  let fz = (p.z - f32(Z));
  let u = mxFade(fx);
  let v = mxFade(fy);
  let w = mxFade(fz);
  let result = mxTrilerp(mxGradientFloat3(mxHashInt2(X, Y, Z), fx, fy, fz), mxGradientFloat3(mxHashInt2((X + 1i), Y, Z), (fx - 1f), fy, fz), mxGradientFloat3(mxHashInt2(X, (Y + 1i), Z), fx, (fy - 1f), fz), mxGradientFloat3(mxHashInt2((X + 1i), (Y + 1i), Z), (fx - 1f), (fy - 1f), fz), mxGradientFloat3(mxHashInt2(X, Y, (Z + 1i)), fx, fy, (fz - 1f)), mxGradientFloat3(mxHashInt2((X + 1i), Y, (Z + 1i)), (fx - 1f), fy, (fz - 1f)), mxGradientFloat3(mxHashInt2(X, (Y + 1i), (Z + 1i)), fx, (fy - 1f), (fz - 1f)), mxGradientFloat3(mxHashInt2((X + 1i), (Y + 1i), (Z + 1i)), (fx - 1f), (fy - 1f), (fz - 1f)), u, v, w);
  return mxGradientScale3d(result);
}

fn mxNoiseFloat3(p: vec3f) -> f32 {
  return mxPerlinNoiseFloat3(p);
}

fn mxBitsTo01(bits: u32) -> f32 {
  return (f32(bits) / 4294967296f);
}

fn mxCellNoiseVec3_2d(p: vec2f) -> vec3f {
  let ix = i32(floor(p.x));
  let iy = i32(floor(p.y));
  return vec3f(mxBitsTo01(mxHashInt2(ix, iy, 0i)), mxBitsTo01(mxHashInt2(ix, iy, 1i)), mxBitsTo01(mxHashInt2(ix, iy, 2i)));
}

fn mxWorleyDistance2d(p: vec2f, x: i32, y: i32, xoff: i32, yoff: i32, jitter: f32, metric: i32) -> f32 {
  let tmp = mxCellNoiseVec3_2d(vec2f(f32((x + xoff)), f32((y + yoff))));
  var off = vec2f(tmp.x, tmp.y);
  off = (((off - 0.5f) * jitter) + 0.5f);
  let cellpos = (vec2f(f32(x), f32(y)) + off);
  let diff = (cellpos - p);
  if ((metric == 2i)) {
    return (abs(diff.x) + abs(diff.y));
  }
  if ((metric == 3i)) {
    return max(abs(diff.x), abs(diff.y));
  }
  return dot(diff, diff);
}

fn mxWorleyNoiseFloat2(p: vec2f, jitter: f32, metric: i32) -> f32 {
  let X = i32(floor(p.x));
  let Y = i32(floor(p.y));
  let localpos = vec2f((p.x - f32(X)), (p.y - f32(Y)));
  var sqdist = 1e+6f;
  for (var x = -1; (x <= 1i); x++) {
    for (var y = -1; (y <= 1i); y++) {
      let dist = mxWorleyDistance2d(localpos, x, y, X, Y, jitter, metric);
      sqdist = min(sqdist, dist);
    }
  }
  if ((metric == 0i)) {
    sqdist = sqrt(sqdist);
  }
  return sqdist;
}

fn mxWorleyNoiseFloat2Pub(p: vec2f, jitter: f32) -> f32 {
  return mxWorleyNoiseFloat2(p, jitter, 1i);
}

fn mxHashInt3(x: i32, y: i32, z: i32, xx: i32) -> u32 {
  const len = 4u;
  let seed = ((3735928559u + (len << 2u)) + 13u);
  var a = (seed + u32(x));
  var b = (seed + u32(y));
  var c = (seed + u32(z));
  a = (a - c);
  a = (a ^ mxRotl32(c, 4i));
  c = (c + b);
  b = (b - a);
  b = (b ^ mxRotl32(a, 6i));
  a = (a + c);
  c = (c - b);
  c = (c ^ mxRotl32(b, 8i));
  b = (b + a);
  a = (a - c);
  a = (a ^ mxRotl32(c, 16i));
  c = (c + b);
  b = (b - a);
  b = (b ^ mxRotl32(a, 19i));
  a = (a + c);
  c = (c - b);
  c = (c ^ mxRotl32(b, 4i));
  b = (b + a);
  a = (a + u32(xx));
  return mxBjfinal(a, b, c);
}

fn mxCellNoiseVec3_3d(p: vec3f) -> vec3f {
  let ix = i32(floor(p.x));
  let iy = i32(floor(p.y));
  let iz = i32(floor(p.z));
  return vec3f(mxBitsTo01(mxHashInt3(ix, iy, iz, 0i)), mxBitsTo01(mxHashInt3(ix, iy, iz, 1i)), mxBitsTo01(mxHashInt3(ix, iy, iz, 2i)));
}

fn mxWorleyDistance3d(p: vec3f, x: i32, y: i32, z: i32, xoff: i32, yoff: i32, zoff: i32, jitter: f32, metric: i32) -> f32 {
  var off = mxCellNoiseVec3_3d(vec3f(f32((x + xoff)), f32((y + yoff)), f32((z + zoff))));
  off = (((off - 0.5f) * jitter) + 0.5f);
  let cellpos = (vec3f(f32(x), f32(y), f32(z)) + off);
  let diff = (cellpos - p);
  if ((metric == 2i)) {
    return ((abs(diff.x) + abs(diff.y)) + abs(diff.z));
  }
  if ((metric == 3i)) {
    return max(max(abs(diff.x), abs(diff.y)), abs(diff.z));
  }
  return dot(diff, diff);
}

fn mxWorleyNoiseFloat3(p: vec3f, jitter: f32, metric: i32) -> f32 {
  let X = i32(floor(p.x));
  let Y = i32(floor(p.y));
  let Z = i32(floor(p.z));
  let localpos = vec3f((p.x - f32(X)), (p.y - f32(Y)), (p.z - f32(Z)));
  var sqdist = 1e+6f;
  for (var x = -1; (x <= 1i); x++) {
    for (var y = -1; (y <= 1i); y++) {
      for (var z = -1; (z <= 1i); z++) {
        let dist = mxWorleyDistance3d(localpos, x, y, z, X, Y, Z, jitter, metric);
        sqdist = min(sqdist, dist);
      }
    }
  }
  if ((metric == 0i)) {
    sqdist = sqrt(sqdist);
  }
  return sqdist;
}

fn mxWorleyNoiseFloat3Pub(p: vec3f, jitter: f32) -> f32 {
  return mxWorleyNoiseFloat3(p, jitter, 1i);
}

struct noiseProbe_Input {
  @location(0) uv: vec2f,
}

@fragment fn noiseProbe(_arg_0: noiseProbe_Input) -> @location(0) vec4f {
  let n2 = mxNoiseFloat2(_arg_0.uv);
  let n3 = mxNoiseFloat3(vec3f(_arg_0.uv.x, _arg_0.uv.y, 0.5f));
  let w2 = mxWorleyNoiseFloat2Pub(_arg_0.uv, 1f);
  let w3 = mxWorleyNoiseFloat3Pub(vec3f(_arg_0.uv.x, _arg_0.uv.y, 0.5f), 1f);
  return vec4f(n2, n3, w2, w3);
}"
