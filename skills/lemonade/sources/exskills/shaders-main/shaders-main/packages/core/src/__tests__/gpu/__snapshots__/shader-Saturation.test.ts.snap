// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Saturation (a) inline path + identity bypass > intensity≠1: emits saturate, still no RTT/unpremultiply > final-pass-intensity2 1`] = `
"fn saturate_1(color: vec4f, intensity: f32) -> vec4f {
  let rgb = vec3f(color.x, color.y, color.z);
  let luminance = dot(rgb, vec3f(0.2125999927520752, 0.7152000069618225, 0.0722000002861023));
  let gray = vec3f(luminance, luminance, luminance);
  let saturated = mix(gray, rgb, vec3f(intensity));
  return vec4f(saturated.x, saturated.y, saturated.z, color.w);
}

fn genBody(uv: vec2f) -> vec4f {
  return vec4f(uv.x, uv.y, 0.5f, 1f);
}

struct padded {
  _opacity: f32,
  _pad0: f32,
  _pad1: f32,
  _pad2: f32,
}

struct padded_1 {
  intensity: f32,
  _opacity: f32,
  _pad0: f32,
  _pad1: f32,
}

struct padded_2 {
  _opacity: f32,
  _pad0: f32,
  _pad1: f32,
  _pad2: f32,
}

struct struct_1 {
  time: f32,
  viewportSize: vec2f,
  logicalViewportSize: vec2f,
  aspect: f32,
  pointer: vec2f,
  pointerActive: f32,
}

struct combined {
  n_root: padded,
  n_s: padded_1,
  n_gen: padded_2,
  _sys: struct_1,
}

@group(0) @binding(0) var<uniform> uniforms: combined;

fn linearToSrgb(color: vec3f) -> vec3f {
  let a = ((pow(color, vec3f(0.41666001081466675)) * 1.055f) - 0.055f);
  let b = (color * 12.92f);
  let factor = (color <= vec3f(0.0031308000907301903));
  return select(a, b, factor);
}

fn tone_linear(color: vec3f) -> vec3f {
  return vec3f(color.x, color.y, color.z);
}

struct final_Input {
  @location(0) uv: vec2f,
}

@fragment fn final_1(in: final_Input) -> @location(0)  vec4f {
  var uv = vec2f(in.uv.x, 1.0 - in.uv.y);
  var composed_0 = saturate_1(genBody(uv), uniforms.n_s.intensity);
  return vec4f(linearToSrgb(tone_linear(composed_0.rgb)), composed_0.a);
}"
`;
