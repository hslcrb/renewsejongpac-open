// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Vignette (a) inline color-filter path (NO RTT) > operates on the composed child inline via std nouns — no RTT, no unpremultiply > final-pass 1`] = `
"fn mixToward(color: vec4f, target_1: vec4f, amount: f32) -> vec4f {
  let rgb = vec3f(color.x, color.y, color.z);
  let targetRgb = vec3f(target_1.x, target_1.y, target_1.z);
  let mixed = mix(rgb, targetRgb, vec3f(amount));
  return vec4f(mixed.x, mixed.y, mixed.z, color.w);
}

fn genBody(uv: vec2f) -> vec4f {
  return vec4f(uv.x, uv.y, 0.5f, 1f);
}

struct padded {
  _opacity: f32,
  _pad0: f32,
  _pad1: f32,
  _pad2: f32,
}

struct struct_1 {
  color: vec4f,
  center: vec2f,
  radius: f32,
  falloff: f32,
  intensity: f32,
  _opacity: f32,
}

struct padded_1 {
  _opacity: f32,
  _pad0: f32,
  _pad1: f32,
  _pad2: f32,
}

struct struct_2 {
  time: f32,
  viewportSize: vec2f,
  logicalViewportSize: vec2f,
  aspect: f32,
  pointer: vec2f,
  pointerActive: f32,
}

struct combined {
  n_root: padded,
  n_v: struct_1,
  n_gen: padded_1,
  _sys: struct_2,
}

@group(0) @binding(0) var<uniform> uniforms: combined;

fn radialFalloffMask(uv: vec2f, aspect: f32, center: vec2f, radius: f32, falloff: f32) -> f32 {
  let aspectUV = vec2f((uv.x * aspect), uv.y);
  let centerPos = vec2f((center.x * aspect), (1f - center.y));
  let dist = length((aspectUV - centerPos));
  return smoothstep(radius, (radius + falloff), dist);
}

fn linearToSrgb(color: vec3f) -> vec3f {
  let a = ((pow(color, vec3f(0.41666001081466675)) * 1.055f) - 0.055f);
  let b = (color * 12.92f);
  let factor = (color <= vec3f(0.0031308000907301903));
  return select(a, b, factor);
}

fn tone_linear(color: vec3f) -> vec3f {
  return vec3f(color.x, color.y, color.z);
}

struct final_Input {
  @location(0) uv: vec2f,
}

@fragment fn final_1(in: final_Input) -> @location(0)  vec4f {
  var uv = vec2f(in.uv.x, 1.0 - in.uv.y);
  var composed_0 = mixToward(genBody(uv), uniforms.n_v.color, (radialFalloffMask(uv, uniforms._sys.aspect, uniforms.n_v.center, uniforms.n_v.radius, uniforms.n_v.falloff) * uniforms.n_v.intensity));
  return vec4f(linearToSrgb(tone_linear(composed_0.rgb)), composed_0.a);
}"
`;
