fn genBody(seed: f32, uv: vec2f) -> vec4f {
  return vec4f(uv.x, uv.y, seed, 1f);
}

fn ditherComposeCustom(colorA: vec4f, colorB: vec4f, ditherResult: f32) -> vec4f {
  let rgb = mix(vec3f(colorA.x, colorA.y, colorA.z), vec3f(colorB.x, colorB.y, colorB.z), vec3f(ditherResult));
  let a = mix(colorA.w, colorB.w, ditherResult);
  return vec4f(rgb.x, rgb.y, rgb.z, a);
}

fn ditherFloydSteinberg(lum: array<f32, 64>, lic: f32, threshold: f32, spread: f32) -> f32 {
  let thr = (0.5f - (threshold - 0.5f));
  var ecur = array<f32, 8>();
  var enext = array<f32, 8>();
  let licInt = i32(lic);
  var result = 0f;
  for (var y = 0; (y < 8i); y++) {
    let ltr = ((y & 1i) == 0i);
    for (var xi = 0; (xi < 8i); xi++) {
      let x = select((7i - xi), xi, ltr);
      let idx = ((y * 8i) + x);
      let val = (lum[idx] + ecur[x]);
      let qv = step(thr, val);
      result = select(result, qv, (idx == licInt));
      let e = ((val - qv) * spread);
      let dir = select(-1i, 1i, ltr);
      let xr = (x + dir);
      if ((xr >= 0i)) {
        if ((xr < 8i)) {
          ecur[xr] = (ecur[xr] + (e * 0.4375f));
        }
      }
      if ((y < 7i)) {
        let xbl = (x - dir);
        let xbr = (x + dir);
        if ((xbl >= 0i)) {
          if ((xbl < 8i)) {
            enext[xbl] = (enext[xbl] + (e * 0.1875f));
          }
        }
        enext[x] = (enext[x] + (e * 0.3125f));
        if ((xbr >= 0i)) {
          if ((xbr < 8i)) {
            enext[xbr] = (enext[xbr] + (e * 0.0625f));
          }
        }
      }
    }
    for (var k = 0; (k < 8i); k++) {
      ecur[k] = enext[k];
      enext[k] = 0f;
    }
  }
  return result;
}

fn ditherLuma(c: vec4f) -> f32 {
  return (dot(vec3f(c.x, c.y, c.z), vec3f(0.29899999499320984, 0.5870000123977661, 0.11400000005960464)) * c.w);
