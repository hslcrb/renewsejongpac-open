exports[`Shatter (b) Voronoi kernel resolves (D3 rules) > the kernel reads the cell-position storage buffer + writes the storage texture > voronoiKernel 1`] = `
"@group(0) @binding(0) var<storage, read> cellPos: array<f32, 32>;

@group(0) @binding(1) var voronoiTex: texture_storage_2d<rgba16float, write>;

fn voronoiNearest2(cx: u32, cy: u32) {
  let u = ((f32(cx) + 0.5f) / 1024f);
  let v = ((f32(cy) + 0.5f) / 1024f);
  var d1 = 99999f;
  var d2 = 99999f;
  var idx1 = 0f;
  var idx2 = 0f;
  for (var i = 0; (i < 16i); i++) {
    let cellX = cellPos[(i * 2i)];
    let cellY = cellPos[((i * 2i) + 1i)];
    let ddx = (u - cellX);
    let ddy = (v - cellY);
    let distSq = ((ddx * ddx) + (ddy * ddy));
    if ((distSq < d1)) {
      d2 = d1;
      idx2 = idx1;
      d1 = distSq;
      idx1 = f32(i);
    }
    else {
      if ((distSq < d2)) {
        d2 = distSq;
        idx2 = f32(i);
      }
    }
  }
  textureStore(voronoiTex, vec2u(cx, cy), vec4f(idx1, idx2, 0f, 0f));
}"
`;
