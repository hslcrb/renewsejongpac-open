  _opacity: f32,
  _pad0: f32,
  _pad1: f32,
}

struct struct_2 {
  time: f32,
  viewportSize: vec2f,
  logicalViewportSize: vec2f,
  aspect: f32,
  pointer: vec2f,
  pointerActive: f32,
}

struct combined {
  n_root: padded,
  n_cp: struct_1,
  n_gen: padded_1,
  _sys: struct_2,
}

@group(0) @binding(0) var<uniform> uniforms: combined;

fn genBody(seed: f32, uv: vec2f) -> vec4f {
  return vec4f(uv.x, uv.y, seed, 1f);
}

fn linearToSrgb(color: vec3f) -> vec3f {
  let a = ((pow(color, vec3f(0.41666001081466675)) * 1.055f) - 0.055f);
  let b = (color * 12.92f);
  let factor = (color <= vec3f(0.0031308000907301903));
  return select(a, b, factor);
}

fn tone_linear(color: vec3f) -> vec3f {
  return vec3f(color.x, color.y, color.z);
}

struct final_Input {
  @location(0) uv: vec2f,
}

@fragment fn final_1(in: final_Input) -> @location(0)  vec4f {
  var uv = vec2f(in.uv.x, 1.0 - in.uv.y);
  let foldUV_1 = edgeClampUV((cornerPinSample(uv, uniforms.n_cp.amount, uniforms.n_cp.topLeft, uniforms.n_cp.topRight, uniforms.n_cp.bottomRight, uniforms.n_cp.bottomLeft)).xy);
  let sibs_0 = genBody(uniforms.n_gen.seed, foldUV_1);
  var composed_2 = vec4f(sibs_0.rgb, (sibs_0.a * (1.0 * (cornerPinSample(uv, uniforms.n_cp.amount, uniforms.n_cp.topLeft, uniforms.n_cp.topRight, uniforms.n_cp.bottomRight, uniforms.n_cp.bottomLeft)).z)));
  return vec4f(linearToSrgb(tone_linear(composed_2.rgb)), composed_2.a);
}"
`;

