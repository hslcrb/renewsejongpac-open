  let c10 = ((a21 - (a31 * a23)) * -1f);
  let c20 = ((a21 * a32) - (a31 * a22));
  let c01 = ((a12 - (a32 * a13)) * -1f);
  let c11 = (a11 - (a31 * a13));
  let c21 = (((a11 * a32) - (a31 * a12)) * -1f);
  let c02 = ((a12 * a23) - (a22 * a13));
  let c12 = (((a11 * a23) - (a21 * a13)) * -1f);
  let c22 = ((a11 * a22) - (a21 * a12));
  let px = coord.x;
  let py = coord.y;
