      let k11 = occupied_1((fx - bxv), ((fy - byv) - eyv), (fz - ezv));
      let k21 = occupied_1((fx + bxv), ((fy + byv) - eyv), (fz - ezv));
      let k12 = occupied_1((fx - bxv), ((fy - byv) + eyv), (fz + ezv));
      let k22 = occupied_1((fx + bxv), ((fy + byv) + eyv), (fz + ezv));
      let ao0 = mix(vertexAo_1(sB1, sC1, k11), vertexAo_1(sB2, sC1, k21), u);
      let ao1 = mix(vertexAo_1(sB1, sC2, k12), vertexAo_1(sB2, sC2, k22), u);
      let ao = mix(ao0, ao1, w);
      let faceId = ((axis * 2f) + max(sgn, 0f));
      fieldVal = (texel * -1f);
      payload = ((faceId * 65536f) + (floor(((ao * 255f) + 0.5f)) * 256f));
      cellPacked = ((hh.cx + (hh.cy * 256f)) + (hh.cz * 65536f));
      depth = hh.t;
    }
    else {
      fieldVal = (texel + max((hh.minD - v), 0f));
    }
  }
  return vec4f(fieldVal, payload, cellPacked, depth);
}

fn viewToGrid_2(v: vec3f, rot: RotStruct) -> vec3f {
  return rotateVec3(rotateVec3(v, vox.cam), rot);
}

fn cellValue_2(cx: f32, cy: f32, cz: f32) -> f32 {
  let vx = (&vox);
  let n = (*vx).gridN;
  var out = 1f;
  if (((((((cx >= 0f) && (cx < n)) && (cy >= 0f)) && (cy < n)) && (cz >= 0f)) && (cz < n))) {
    let wx = floor((cx * 0.25f));
    let sub = (cx - (wx * 4f));
    let idx = (u32(wx) + ((u32(cy) + (u32(cz) * u32(n))) * u32((*vx).gridW)));
    let word = occ[idx];
    out = f32(extractBits(word, (u32(sub) * 8u), 8u));
  }
  return out;
}

fn cellCentre_2(cx: f32, cy: f32, cz: f32) -> vec3f {
  let vx = (&vox);
  return vec3f((((cx + 0.5f) * (*vx).voxelSize) + (*vx).gridOrigin), (((cy + 0.5f) * (*vx).voxelSize) + (*vx).gridOrigin), (((cz + 0.5f) * (*vx).voxelSize) + (*vx).gridOrigin));
}

struct SubHit_2 {
  hit: f32,
  t: f32,
}

fn subShapeHit_2(ro: vec3f, rd: vec3f, c: vec3f, tNow: f32) -> SubHit_2 {
  let vx = (&vox);
  let h = (((*vx).voxelSize * 0.5f) * (*vx).voxelScale);
  var hit = 0f;
  var t = tNow;
  {
    let oc = (ro - c);
    let b = dot(oc, rd);
    let cc = (dot(oc, oc) - (h * h));
    let disc = ((b * b) - cc);
    if ((disc >= 0f)) {
      let ts = ((b * -1f) - sqrt(disc));
      if ((ts >= (tNow - 1e-4f))) {
        hit = 1f;
        t = ts;
      }
    }
  }
  return SubHit_2(hit, t);
}

struct DdaHit_2 {
  hit: f32,
  t: f32,
  cx: f32,
  cy: f32,
  cz: f32,
  minD: f32,
}

fn voxelDda_2(ro: vec3f, rd: vec3f, tStart: f32, tEnd: f32, skip: vec3f, maxSteps: i32) -> DdaHit_2 {
  let vx = (&vox);
  let v = (*vx).voxelSize;
  let o = (*vx).gridOrigin;
  let p0 = (ro + (rd * tStart));
  var cx = floor(((p0.x - o) / v));
  var cy = floor(((p0.y - o) / v));
  var cz = floor(((p0.z - o) / v));
  let sx = select(-1f, 1f, (rd.x >= 0f));
  let sy = select(-1f, 1f, (rd.y >= 0f));
  let sz = select(-1f, 1f, (rd.z >= 0f));
  let ax = (1f / max(abs(rd.x), 1e-6f));
  let ay = (1f / max(abs(rd.y), 1e-6f));
  let az = (1f / max(abs(rd.z), 1e-6f));
  let dtx = (v * ax);
  let dty = (v * ay);
  let dtz = (v * az);
  let bx = (((cx + max(sx, 0f)) * v) + o);
  let by = (((cy + max(sy, 0f)) * v) + o);
  let bz = (((cz + max(sz, 0f)) * v) + o);
  var tmx = (tStart + (((bx - p0.x) * sx) * ax));
  var tmy = (tStart + (((by - p0.y) * sy) * ay));
  var tmz = (tStart + (((bz - p0.z) * sz) * az));
  var t = tStart;
  var hit = 0f;
  var tHit = tEnd;
  var minClear = 255f;
  for (var i = 0; (i < maxSteps); i++) {
    let same = step(((abs((cx - skip.x)) + abs((cy - skip.y))) + abs((cz - skip.z))), 0.5f);
    let val = cellValue_2(cx, cy, cz);
    let clear = max((val - 1f), 0f);
    minClear = min(minClear, clear);
    if ((val < 0.5f)) {
      if ((same < 0.5f)) {
        let sh = subShapeHit_2(ro, rd, cellCentre_2(cx, cy, cz), t);
        if ((sh.hit > 0.5f)) {
          hit = 1f;
          tHit = sh.t;
          break;
        }
      }
    }
    if ((clear >= 1f)) {
      t = (t + (clear * v));
      let pj = (ro + (rd * t));
      cx = floor(((pj.x - o) / v));
      cy = floor(((pj.y - o) / v));
      cz = floor(((pj.z - o) / v));
      tmx = (t + ((((((cx + max(sx, 0f)) * v) + o) - pj.x) * sx) * ax));
      tmy = (t + ((((((cy + max(sy, 0f)) * v) + o) - pj.y) * sy) * ay));
      tmz = (t + ((((((cz + max(sz, 0f)) * v) + o) - pj.z) * sz) * az));
    }
    else {
      if ((tmx < tmy)) {
        if ((tmx < tmz)) {
          t = tmx;
          cx = (cx + sx);
          tmx = (tmx + dtx);
        }
        else {
          t = tmz;
          cz = (cz + sz);
          tmz = (tmz + dtz);
        }
      }
      else {
        if ((tmy < tmz)) {
          t = tmy;
          cy = (cy + sy);
          tmy = (tmy + dty);
        }
        else {
          t = tmz;
          cz = (cz + sz);
          tmz = (tmz + dtz);
        }
      }
    }
    if ((t > tEnd)) {
      break;
    }
  }
  return DdaHit_2(hit, tHit, cx, cy, cz, (minClear * v));
}

fn occupied_2(cx: f32, cy: f32, cz: f32) -> f32 {
  return select(0f, 1f, (cellValue_2(cx, cy, cz) < 0.5f));
}

fn vertexAo_2(s1: f32, s2: f32, k: f32) -> f32 {
  let open = ((3f - ((s1 + s2) + k)) / 3f);
  return select(open, 0f, ((s1 + s2) > 1.5f));
}

fn voxelFieldMarch_sphere_shape(fuv: vec2f, rot: RotStruct, rBound: f32) -> vec4f {
  let vx = (&vox);
  let v = (*vx).voxelSize;
  let ro = viewToGrid_2(vec3f((fuv.x - 0.5f), (0.5f - fuv.y), -1.2f), rot);
  let rd = viewToGrid_2(vec3f(0, 0, 1), rot);
  let b = dot(ro, rd);
  let perp2 = max((dot(ro, ro) - (b * b)), 0f);
  let halfSpan = sqrt(max(((rBound * rBound) - perp2), 0f));
  let tStart = max(((b * -1f) - halfSpan), 0f);
  let tEnd = (((b * -1f) + halfSpan) + 0.01f);
  let mp = (&params);
  let texel = (max((*mp).spanX, (*mp).spanY) / f32((*mp).activeRes));
  var fieldVal = ((sqrt(perp2) - rBound) + texel);
  var payload = 0f;
  var cellPacked = 0f;
  var depth = (tEnd + 0.4f);
  if ((perp2 < (rBound * rBound))) {
    let maxSteps = i32(clamp((((rBound * 6f) / v) + 8f), 8f, 720f));
    let none = vec3f(-9999);
    let hh = voxelDda_2(ro, rd, tStart, tEnd, none, maxSteps);
    if ((hh.hit > 0.5f)) {
      let hp = (ro + (rd * hh.t));
      let c = cellCentre_2(hh.cx, hh.cy, hh.cz);
      let l = (hp - c);
      let alx = abs(l.x);
      let aly = abs(l.y);
      let alz = abs(l.z);
      var axis = 0f;
      if ((aly > alx)) {
        if ((aly >= alz)) {
          axis = 1f;
        }
        else {
          axis = 2f;
        }
      }
      else {
        if ((alz > alx)) {
          axis = 2f;
        }
      }
      let la = select(select(l.x, l.y, (axis > 0.5f)), l.z, (axis > 1.5f));
      let sgn = select(-1f, 1f, (la >= 0f));
      let isX = select(0f, 1f, (axis < 0.5f));
      let isZ = select(0f, 1f, (axis > 1.5f));
      let isY = ((1f - isX) - isZ);
      let nx = (sgn * isX);
      let ny = (sgn * isY);
      let nz = (sgn * isZ);
      let bxv = (1f - isX);
      let byv = isX;
      let eyv = isZ;
      let ezv = (1f - isZ);
      let lb = ((l.x * bxv) + (l.y * byv));
      let lc = ((l.y * eyv) + (l.z * ezv));
      let h = ((v * 0.5f) * (*vx).voxelScale);
      let u = clamp(((lb / (2f * h)) + 0.5f), 0f, 1f);
      let w = clamp(((lc / (2f * h)) + 0.5f), 0f, 1f);
      let fx = (hh.cx + nx);
      let fy = (hh.cy + ny);
      let fz = (hh.cz + nz);
      let sB1 = occupied_2((fx - bxv), (fy - byv), fz);
      let sB2 = occupied_2((fx + bxv), (fy + byv), fz);
      let sC1 = occupied_2(fx, (fy - eyv), (fz - ezv));
      let sC2 = occupied_2(fx, (fy + eyv), (fz + ezv));
      let k11 = occupied_2((fx - bxv), ((fy - byv) - eyv), (fz - ezv));
      let k21 = occupied_2((fx + bxv), ((fy + byv) - eyv), (fz - ezv));
      let k12 = occupied_2((fx - bxv), ((fy - byv) + eyv), (fz + ezv));
      let k22 = occupied_2((fx + bxv), ((fy + byv) + eyv), (fz + ezv));
      let ao0 = mix(vertexAo_2(sB1, sC1, k11), vertexAo_2(sB2, sC1, k21), u);
      let ao1 = mix(vertexAo_2(sB1, sC2, k12), vertexAo_2(sB2, sC2, k22), u);
      let ao = mix(ao0, ao1, w);
      let faceId = ((axis * 2f) + max(sgn, 0f));
      fieldVal = (texel * -1f);
      payload = ((faceId * 65536f) + (floor(((ao * 255f) + 0.5f)) * 256f));
      cellPacked = ((hh.cx + (hh.cy * 256f)) + (hh.cz * 65536f));
      depth = hh.t;
    }
    else {
      fieldVal = (texel + max((hh.minD - v), 0f));
    }
  }
  return vec4f(fieldVal, payload, cellPacked, depth);
}

