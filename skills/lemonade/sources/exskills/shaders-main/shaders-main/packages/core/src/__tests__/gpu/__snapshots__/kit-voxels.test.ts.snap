          cz = (cz + sz);
          tmz = (tmz + dtz);
        }
      }
      else {
        if ((tmy < tmz)) {
          t = tmy;
          cy = (cy + sy);
          tmy = (tmy + dty);
        }
        else {
          t = tmz;
          cz = (cz + sz);
          tmz = (tmz + dtz);
        }
      }
    }
    if ((t > tEnd)) {
      break;
    }
  }
  return DdaHit_1(hit, tHit, cx, cy, cz, (minClear * v));
}

