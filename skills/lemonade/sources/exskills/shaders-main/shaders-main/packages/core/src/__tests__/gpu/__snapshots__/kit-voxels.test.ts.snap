}

fn voxelFieldMarch_rounded_shape(fuv: vec2f, rot: RotStruct, rBound: f32) -> vec4f {
  let vx = (&vox);
  let v = (*vx).voxelSize;
  let ro = viewToGrid_4(vec3f((fuv.x - 0.5f), (0.5f - fuv.y), -1.2f), rot);
  let rd = viewToGrid_4(vec3f(0, 0, 1), rot);
  let b = dot(ro, rd);
  let perp2 = max((dot(ro, ro) - (b * b)), 0f);
  let halfSpan = sqrt(max(((rBound * rBound) - perp2), 0f));
  let tStart = max(((b * -1f) - halfSpan), 0f);
  let tEnd = (((b * -1f) + halfSpan) + 0.01f);
  let mp = (&params);
  let texel = (max((*mp).spanX, (*mp).spanY) / f32((*mp).activeRes));
  var fieldVal = ((sqrt(perp2) - rBound) + texel);
  var payload = 0f;
  var cellPacked = 0f;
  var depth = (tEnd + 0.4f);
  if ((perp2 < (rBound * rBound))) {
    let maxSteps = i32(clamp((((rBound * 6f) / v) + 8f), 8f, 720f));
    let none = vec3f(-9999);
    let hh = voxelDda_4(ro, rd, tStart, tEnd, none, maxSteps);
    if ((hh.hit > 0.5f)) {
      let hp = (ro + (rd * hh.t));
      let c = cellCentre_4(hh.cx, hh.cy, hh.cz);
      let l = (hp - c);
      let alx = abs(l.x);
      let aly = abs(l.y);
      let alz = abs(l.z);
      var axis = 0f;
      if ((aly > alx)) {
        if ((aly >= alz)) {
          axis = 1f;
        }
        else {
          axis = 2f;
        }
      }
      else {
        if ((alz > alx)) {
          axis = 2f;
        }
      }
      let la = select(select(l.x, l.y, (axis > 0.5f)), l.z, (axis > 1.5f));
      let sgn = select(-1f, 1f, (la >= 0f));
      let isX = select(0f, 1f, (axis < 0.5f));
      let isZ = select(0f, 1f, (axis > 1.5f));
      let isY = ((1f - isX) - isZ);
      let nx = (sgn * isX);
      let ny = (sgn * isY);
      let nz = (sgn * isZ);
      let bxv = (1f - isX);
      let byv = isX;
      let eyv = isZ;
      let ezv = (1f - isZ);
      let lb = ((l.x * bxv) + (l.y * byv));
      let lc = ((l.y * eyv) + (l.z * ezv));
      let h = ((v * 0.5f) * (*vx).voxelScale);
      let u = clamp(((lb / (2f * h)) + 0.5f), 0f, 1f);
      let w = clamp(((lc / (2f * h)) + 0.5f), 0f, 1f);
      let fx = (hh.cx + nx);
      let fy = (hh.cy + ny);
      let fz = (hh.cz + nz);
      let sB1 = occupied_4((fx - bxv), (fy - byv), fz);
      let sB2 = occupied_4((fx + bxv), (fy + byv), fz);
      let sC1 = occupied_4(fx, (fy - eyv), (fz - ezv));
      let sC2 = occupied_4(fx, (fy + eyv), (fz + ezv));
      let k11 = occupied_4((fx - bxv), ((fy - byv) - eyv), (fz - ezv));
      let k21 = occupied_4((fx + bxv), ((fy + byv) - eyv), (fz - ezv));
      let k12 = occupied_4((fx - bxv), ((fy - byv) + eyv), (fz + ezv));
      let k22 = occupied_4((fx + bxv), ((fy + byv) + eyv), (fz + ezv));
      let ao0 = mix(vertexAo_4(sB1, sC1, k11), vertexAo_4(sB2, sC1, k21), u);
      let ao1 = mix(vertexAo_4(sB1, sC2, k12), vertexAo_4(sB2, sC2, k22), u);
      let ao = mix(ao0, ao1, w);
      let faceId = ((axis * 2f) + max(sgn, 0f));
      fieldVal = (texel * -1f);
      payload = ((faceId * 65536f) + (floor(((ao * 255f) + 0.5f)) * 256f));
      cellPacked = ((hh.cx + (hh.cy * 256f)) + (hh.cz * 65536f));
      depth = hh.t;
    }
    else {
      fieldVal = (texel + max((hh.minD - v), 0f));
    }
  }
  return vec4f(fieldVal, payload, cellPacked, depth);
}

