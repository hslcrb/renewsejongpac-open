fn sdRoundBox(p: vec3f, hx: f32, hy: f32, hz: f32, rounding: f32) -> f32 {
  let qx = ((abs(p.x) - hx) + rounding);
  let qy = ((abs(p.y) - hy) + rounding);
  let qz = ((abs(p.z) - hz) + rounding);
  let outer = length(vec3f(max(qx, 0f), max(qy, 0f), max(qz, 0f)));
  let inner = min(max(qx, max(qy, qz)), 0f);
  return ((outer + inner) - rounding);
}

struct SubHit_4 {
  hit: f32,
  t: f32,
}

fn subShapeHit_4(ro: vec3f, rd: vec3f, c: vec3f, tNow: f32) -> SubHit_4 {
  let vx = (&vox);
  let h = (((*vx).voxelSize * 0.5f) * (*vx).voxelScale);
  var hit = 0f;
  var t = tNow;
  {
    let sx = select(-1f, 1f, (rd.x >= 0f));
    let sy = select(-1f, 1f, (rd.y >= 0f));
    let sz = select(-1f, 1f, (rd.z >= 0f));
    let ix = (sx / max(abs(rd.x), 1e-6f));
    let iy = (sy / max(abs(rd.y), 1e-6f));
    let iz = (sz / max(abs(rd.z), 1e-6f));
    let t1x = (((c.x - h) - ro.x) * ix);
    let t2x = (((c.x + h) - ro.x) * ix);
    let t1y = (((c.y - h) - ro.y) * iy);
    let t2y = (((c.y + h) - ro.y) * iy);
    let t1z = (((c.z - h) - ro.z) * iz);
    let t2z = (((c.z + h) - ro.z) * iz);
    let tIn = max(min(t1x, t2x), max(min(t1y, t2y), min(t1z, t2z)));
    let tOut = min(max(t1x, t2x), min(max(t1y, t2y), max(t1z, t2z)));
    if ((tIn <= tOut)) {
      if ((tOut >= (tNow - 1e-4f))) {
        {
          let r = (clamp((*vx).bevel, 0f, 1f) * h);
          var s = max(tIn, (tNow - 1e-4f));
          for (var i = 0; (i < 12i); i++) {
            let p = ((ro + (rd * s)) - c);
            let dd = sdRoundBox(p, h, h, h, r);
            if ((dd < (h * 3e-3f))) {
              hit = 1f;
              break;
            }
            s = (s + dd);
            if ((s > tOut)) {
              break;
            }
          }
          t = s;
        }
      }
    }
  }
  return SubHit_4(hit, t);
}

struct DdaHit_4 {
  hit: f32,
  t: f32,
  cx: f32,
  cy: f32,
  cz: f32,
  minD: f32,
}

fn voxelDda_4(ro: vec3f, rd: vec3f, tStart: f32, tEnd: f32, skip: vec3f, maxSteps: i32) -> DdaHit_4 {
  let vx = (&vox);
  let v = (*vx).voxelSize;
  let o = (*vx).gridOrigin;
  let p0 = (ro + (rd * tStart));
  var cx = floor(((p0.x - o) / v));
  var cy = floor(((p0.y - o) / v));
  var cz = floor(((p0.z - o) / v));
  let sx = select(-1f, 1f, (rd.x >= 0f));
  let sy = select(-1f, 1f, (rd.y >= 0f));
  let sz = select(-1f, 1f, (rd.z >= 0f));
  let ax = (1f / max(abs(rd.x), 1e-6f));
  let ay = (1f / max(abs(rd.y), 1e-6f));
  let az = (1f / max(abs(rd.z), 1e-6f));
  let dtx = (v * ax);
  let dty = (v * ay);
  let dtz = (v * az);
  let bx = (((cx + max(sx, 0f)) * v) + o);
  let by = (((cy + max(sy, 0f)) * v) + o);
  let bz = (((cz + max(sz, 0f)) * v) + o);
  var tmx = (tStart + (((bx - p0.x) * sx) * ax));
  var tmy = (tStart + (((by - p0.y) * sy) * ay));
  var tmz = (tStart + (((bz - p0.z) * sz) * az));
  var t = tStart;
  var hit = 0f;
  var tHit = tEnd;
  var minClear = 255f;
  for (var i = 0; (i < maxSteps); i++) {
    let same = step(((abs((cx - skip.x)) + abs((cy - skip.y))) + abs((cz - skip.z))), 0.5f);
    let val = cellValue_4(cx, cy, cz);
    let clear = max((val - 1f), 0f);
    minClear = min(minClear, clear);
    if ((val < 0.5f)) {
      if ((same < 0.5f)) {
        let sh = subShapeHit_4(ro, rd, cellCentre_4(cx, cy, cz), t);
        if ((sh.hit > 0.5f)) {
          hit = 1f;
          tHit = sh.t;
          break;
        }
      }
    }
    if ((clear >= 1f)) {
      t = (t + (clear * v));
      let pj = (ro + (rd * t));
      cx = floor(((pj.x - o) / v));
      cy = floor(((pj.y - o) / v));
      cz = floor(((pj.z - o) / v));
      tmx = (t + ((((((cx + max(sx, 0f)) * v) + o) - pj.x) * sx) * ax));
      tmy = (t + ((((((cy + max(sy, 0f)) * v) + o) - pj.y) * sy) * ay));
      tmz = (t + ((((((cz + max(sz, 0f)) * v) + o) - pj.z) * sz) * az));
    }
    else {
      if ((tmx < tmy)) {
        if ((tmx < tmz)) {
          t = tmx;
          cx = (cx + sx);
          tmx = (tmx + dtx);
        }
        else {
          t = tmz;
          cz = (cz + sz);
          tmz = (tmz + dtz);
        }
      }
      else {
        if ((tmy < tmz)) {
          t = tmy;
          cy = (cy + sy);
          tmy = (tmy + dty);
        }
        else {
          t = tmz;
          cz = (cz + sz);
          tmz = (tmz + dtz);
        }
      }
    }
    if ((t > tEnd)) {
      break;
    }
  }
  return DdaHit_4(hit, tHit, cx, cy, cz, (minClear * v));
}

fn occupied_4(cx: f32, cy: f32, cz: f32) -> f32 {
  return select(0f, 1f, (cellValue_4(cx, cy, cz) < 0.5f));
}

fn vertexAo_4(s1: f32, s2: f32, k: f32) -> f32 {
  let open = ((3f - ((s1 + s2) + k)) / 3f);
