// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`kit/voxels (a) DDA march resolve gate > all style × gridSpace variants + the kernel + the texel sampler resolve to WGSL (snapshot) 1`] = `
"struct RotStruct {
  cx: f32,
  sx: f32,
  cy: f32,
  sy: f32,
  cz: f32,
  sz: f32,
}

struct VoxelMarchParams {
  @align(16) @size(32) cam: RotStruct,
  lightDir: vec3f,
  voxelSize: f32,
  lightT1: vec3f,
  fill: f32,
  lightT2: vec3f,
  voxelScale: f32,
  bevel: f32,
  gridOrigin: f32,
  gridN: f32,
  gridW: f32,
}

@group(0) @binding(0) var<uniform> vox: VoxelMarchParams;

fn rotateVec3(v: vec3f, rot: RotStruct) -> vec3f {
  let x1 = ((v.x * rot.cy) + (v.z * rot.sy));
  let z1 = ((v.z * rot.cy) - (v.x * rot.sy));
  let y2 = ((v.y * rot.cx) - (z1 * rot.sx));
  let z2 = ((v.y * rot.sx) + (z1 * rot.cx));
  let x3 = ((x1 * rot.cz) - (y2 * rot.sz));
  let y3 = ((x1 * rot.sz) + (y2 * rot.cz));
  return vec3f(x3, y3, z2);
}

fn viewToGrid(v: vec3f, rot: RotStruct) -> vec3f {
  return rotateVec3(rotateVec3(v, vox.cam), rot);
}

struct MarchParams {
  @align(16) @size(32) rot: RotStruct,
  rBound: f32,
  spanX: f32,
  spanY: f32,
  originX: f32,
  originY: f32,
  activeRes: u32,
  pA: f32,
  pB: f32,
  pC: f32,
  pD: f32,
  mb0: vec3f,
  mb1: vec3f,
  mb2: vec3f,
  mb3: vec3f,
  mb4: vec3f,
  mb5: vec3f,
  mb6: vec3f,
  mb7: vec3f,
}

@group(1) @binding(1) var<uniform> params: MarchParams;

@group(0) @binding(1) var<storage, read> occ: array<u32, 1769472>;

fn cellValue(cx: f32, cy: f32, cz: f32) -> f32 {
  let vx = (&vox);
  let n = (*vx).gridN;
  var out = 1f;
  if (((((((cx >= 0f) && (cx < n)) && (cy >= 0f)) && (cy < n)) && (cz >= 0f)) && (cz < n))) {
    let wx = floor((cx * 0.25f));
    let sub = (cx - (wx * 4f));
    let idx = (u32(wx) + ((u32(cy) + (u32(cz) * u32(n))) * u32((*vx).gridW)));
    let word = occ[idx];
    out = f32(extractBits(word, (u32(sub) * 8u), 8u));
  }
  return out;
}

fn cellCentre(cx: f32, cy: f32, cz: f32) -> vec3f {
  let vx = (&vox);
  return vec3f((((cx + 0.5f) * (*vx).voxelSize) + (*vx).gridOrigin), (((cy + 0.5f) * (*vx).voxelSize) + (*vx).gridOrigin), (((cz + 0.5f) * (*vx).voxelSize) + (*vx).gridOrigin));
}

struct SubHit {
  hit: f32,
  t: f32,
}

fn subShapeHit(ro: vec3f, rd: vec3f, c: vec3f, tNow: f32) -> SubHit {
  let vx = (&vox);
  let h = (((*vx).voxelSize * 0.5f) * (*vx).voxelScale);
  var hit = 0f;
  var t = tNow;
  {
    let sx = select(-1f, 1f, (rd.x >= 0f));
    let sy = select(-1f, 1f, (rd.y >= 0f));
    let sz = select(-1f, 1f, (rd.z >= 0f));
    let ix = (sx / max(abs(rd.x), 1e-6f));
    let iy = (sy / max(abs(rd.y), 1e-6f));
    let iz = (sz / max(abs(rd.z), 1e-6f));
    let t1x = (((c.x - h) - ro.x) * ix);
    let t2x = (((c.x + h) - ro.x) * ix);
    let t1y = (((c.y - h) - ro.y) * iy);
    let t2y = (((c.y + h) - ro.y) * iy);
    let t1z = (((c.z - h) - ro.z) * iz);
    let t2z = (((c.z + h) - ro.z) * iz);
    let tIn = max(min(t1x, t2x), max(min(t1y, t2y), min(t1z, t2z)));
    let tOut = min(max(t1x, t2x), min(max(t1y, t2y), max(t1z, t2z)));
    if ((tIn <= tOut)) {
      if ((tOut >= (tNow - 1e-4f))) {
        hit = 1f;
        t = max(tIn, tNow);
      }
    }
  }
  return SubHit(hit, t);
}

struct DdaHit {
  hit: f32,
  t: f32,
  cx: f32,
  cy: f32,
  cz: f32,
  minD: f32,
}

fn voxelDda(ro: vec3f, rd: vec3f, tStart: f32, tEnd: f32, skip: vec3f, maxSteps: i32) -> DdaHit {
  let vx = (&vox);
  let v = (*vx).voxelSize;
  let o = (*vx).gridOrigin;
  let p0 = (ro + (rd * tStart));
  var cx = floor(((p0.x - o) / v));
  var cy = floor(((p0.y - o) / v));
  var cz = floor(((p0.z - o) / v));
  let sx = select(-1f, 1f, (rd.x >= 0f));
  let sy = select(-1f, 1f, (rd.y >= 0f));
  let sz = select(-1f, 1f, (rd.z >= 0f));
  let ax = (1f / max(abs(rd.x), 1e-6f));
  let ay = (1f / max(abs(rd.y), 1e-6f));
  let az = (1f / max(abs(rd.z), 1e-6f));
  let dtx = (v * ax);
  let dty = (v * ay);
  let dtz = (v * az);
  let bx = (((cx + max(sx, 0f)) * v) + o);
  let by = (((cy + max(sy, 0f)) * v) + o);
  let bz = (((cz + max(sz, 0f)) * v) + o);
  var tmx = (tStart + (((bx - p0.x) * sx) * ax));
  var tmy = (tStart + (((by - p0.y) * sy) * ay));
  var tmz = (tStart + (((bz - p0.z) * sz) * az));
  var t = tStart;
  var hit = 0f;
  var tHit = tEnd;
  var minClear = 255f;
  for (var i = 0; (i < maxSteps); i++) {
    let same = step(((abs((cx - skip.x)) + abs((cy - skip.y))) + abs((cz - skip.z))), 0.5f);
    let val = cellValue(cx, cy, cz);
    let clear = max((val - 1f), 0f);
    minClear = min(minClear, clear);
    if ((val < 0.5f)) {
      if ((same < 0.5f)) {
        let sh = subShapeHit(ro, rd, cellCentre(cx, cy, cz), t);
        if ((sh.hit > 0.5f)) {
          hit = 1f;
          tHit = sh.t;
          break;
        }
      }
    }
    if ((clear >= 1f)) {
      t = (t + (clear * v));
      let pj = (ro + (rd * t));
      cx = floor(((pj.x - o) / v));
      cy = floor(((pj.y - o) / v));
      cz = floor(((pj.z - o) / v));
      tmx = (t + ((((((cx + max(sx, 0f)) * v) + o) - pj.x) * sx) * ax));
      tmy = (t + ((((((cy + max(sy, 0f)) * v) + o) - pj.y) * sy) * ay));
      tmz = (t + ((((((cz + max(sz, 0f)) * v) + o) - pj.z) * sz) * az));
    }
    else {
      if ((tmx < tmy)) {
        if ((tmx < tmz)) {
          t = tmx;
          cx = (cx + sx);
          tmx = (tmx + dtx);
        }
        else {
          t = tmz;
          cz = (cz + sz);
          tmz = (tmz + dtz);
        }
      }
      else {
        if ((tmy < tmz)) {
          t = tmy;
          cy = (cy + sy);
          tmy = (tmy + dty);
        }
        else {
          t = tmz;
          cz = (cz + sz);
          tmz = (tmz + dtz);
        }
      }
    }
    if ((t > tEnd)) {
      break;
    }
  }
  return DdaHit(hit, tHit, cx, cy, cz, (minClear * v));
}

fn occupied(cx: f32, cy: f32, cz: f32) -> f32 {
  return select(0f, 1f, (cellValue(cx, cy, cz) < 0.5f));
}

fn vertexAo(s1: f32, s2: f32, k: f32) -> f32 {
  let open = ((3f - ((s1 + s2) + k)) / 3f);
  return select(open, 0f, ((s1 + s2) > 1.5f));
}

fn voxelFieldMarch_cube_shape(fuv: vec2f, rot: RotStruct, rBound: f32) -> vec4f {
  let vx = (&vox);
  let v = (*vx).voxelSize;
  let ro = viewToGrid(vec3f((fuv.x - 0.5f), (0.5f - fuv.y), -1.2f), rot);
  let rd = viewToGrid(vec3f(0, 0, 1), rot);
  let b = dot(ro, rd);
  let perp2 = max((dot(ro, ro) - (b * b)), 0f);
  let halfSpan = sqrt(max(((rBound * rBound) - perp2), 0f));
  let tStart = max(((b * -1f) - halfSpan), 0f);
  let tEnd = (((b * -1f) + halfSpan) + 0.01f);
  let mp = (&params);
  let texel = (max((*mp).spanX, (*mp).spanY) / f32((*mp).activeRes));
  var fieldVal = ((sqrt(perp2) - rBound) + texel);
  var payload = 0f;
  var cellPacked = 0f;
  var depth = (tEnd + 0.4f);
  if ((perp2 < (rBound * rBound))) {
    let maxSteps = i32(clamp((((rBound * 6f) / v) + 8f), 8f, 720f));
    let none = vec3f(-9999);
    let hh = voxelDda(ro, rd, tStart, tEnd, none, maxSteps);
    if ((hh.hit > 0.5f)) {
      let hp = (ro + (rd * hh.t));
      let c = cellCentre(hh.cx, hh.cy, hh.cz);
      let l = (hp - c);
      let alx = abs(l.x);
      let aly = abs(l.y);
      let alz = abs(l.z);
      var axis = 0f;
      if ((aly > alx)) {
        if ((aly >= alz)) {
          axis = 1f;
        }
        else {
          axis = 2f;
        }
      }
      else {
        if ((alz > alx)) {
          axis = 2f;
        }
      }
      let la = select(select(l.x, l.y, (axis > 0.5f)), l.z, (axis > 1.5f));
      let sgn = select(-1f, 1f, (la >= 0f));
      let isX = select(0f, 1f, (axis < 0.5f));
      let isZ = select(0f, 1f, (axis > 1.5f));
      let isY = ((1f - isX) - isZ);
      let nx = (sgn * isX);
      let ny = (sgn * isY);
      let nz = (sgn * isZ);
      let bxv = (1f - isX);
      let byv = isX;
      let eyv = isZ;
      let ezv = (1f - isZ);
      let lb = ((l.x * bxv) + (l.y * byv));
      let lc = ((l.y * eyv) + (l.z * ezv));
      let h = ((v * 0.5f) * (*vx).voxelScale);
      let u = clamp(((lb / (2f * h)) + 0.5f), 0f, 1f);
      let w = clamp(((lc / (2f * h)) + 0.5f), 0f, 1f);
      let fx = (hh.cx + nx);
      let fy = (hh.cy + ny);
      let fz = (hh.cz + nz);
      let sB1 = occupied((fx - bxv), (fy - byv), fz);
      let sB2 = occupied((fx + bxv), (fy + byv), fz);
      let sC1 = occupied(fx, (fy - eyv), (fz - ezv));
      let sC2 = occupied(fx, (fy + eyv), (fz + ezv));
      let k11 = occupied((fx - bxv), ((fy - byv) - eyv), (fz - ezv));
      let k21 = occupied((fx + bxv), ((fy + byv) - eyv), (fz - ezv));
      let k12 = occupied((fx - bxv), ((fy - byv) + eyv), (fz + ezv));
      let k22 = occupied((fx + bxv), ((fy + byv) + eyv), (fz + ezv));
      let ao0 = mix(vertexAo(sB1, sC1, k11), vertexAo(sB2, sC1, k21), u);
      let ao1 = mix(vertexAo(sB1, sC2, k12), vertexAo(sB2, sC2, k22), u);
      let ao = mix(ao0, ao1, w);
      let faceId = ((axis * 2f) + max(sgn, 0f));
      fieldVal = (texel * -1f);
      payload = ((faceId * 65536f) + (floor(((ao * 255f) + 0.5f)) * 256f));
      cellPacked = ((hh.cx + (hh.cy * 256f)) + (hh.cz * 65536f));
      depth = hh.t;
    }
    else {
      fieldVal = (texel + max((hh.minD - v), 0f));
    }
  }
  return vec4f(fieldVal, payload, cellPacked, depth);
}

fn viewToGrid_1(v: vec3f, rot: RotStruct) -> vec3f {
  return vec3f(v.x, v.y, v.z);
}

fn cellValue_1(cx: f32, cy: f32, cz: f32) -> f32 {
  let vx = (&vox);
  let n = (*vx).gridN;
  var out = 1f;
