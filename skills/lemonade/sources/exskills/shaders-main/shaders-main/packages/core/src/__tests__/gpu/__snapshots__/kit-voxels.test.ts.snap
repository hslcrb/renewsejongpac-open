    }
    if ((clear >= 1f)) {
      t = (t + (clear * v));
      let pj = (ro + (rd * t));
      cx = floor(((pj.x - o) / v));
      cy = floor(((pj.y - o) / v));
      cz = floor(((pj.z - o) / v));
      tmx = (t + ((((((cx + max(sx, 0f)) * v) + o) - pj.x) * sx) * ax));
      tmy = (t + ((((((cy + max(sy, 0f)) * v) + o) - pj.y) * sy) * ay));
      tmz = (t + ((((((cz + max(sz, 0f)) * v) + o) - pj.z) * sz) * az));
    }
