  let halfSpan = sqrt(max(((rBound * rBound) - perp2), 0f));
  let tStart = max(((b * -1f) - halfSpan), 0f);
  let tEnd = (((b * -1f) + halfSpan) + 0.01f);
  let mp = (&params);
  let texel = (max((*mp).spanX, (*mp).spanY) / f32((*mp).activeRes));
  var fieldVal = ((sqrt(perp2) - rBound) + texel);
  var payload = 0f;
  var cellPacked = 0f;
  var depth = (tEnd + 0.4f);
  if ((perp2 < (rBound * rBound))) {
    let maxSteps = i32(clamp((((rBound * 6f) / v) + 8f), 8f, 720f));
    let none = vec3f(-9999);
    let hh = voxelDda_8(ro, rd, tStart, tEnd, none, maxSteps);
    if ((hh.hit > 0.5f)) {
      let hp = (ro + (rd * hh.t));
      let c = cellCentre_8(hh.cx, hh.cy, hh.cz);
      let l = (hp - c);
      let alx = abs(l.x);
      let aly = abs(l.y);
      let alz = abs(l.z);
      var axis = 0f;
      if ((aly > alx)) {
        if ((aly >= alz)) {
          axis = 1f;
        }
        else {
          axis = 2f;
        }
      }
      else {
        if ((alz > alx)) {
          axis = 2f;
        }
      }
      let la = select(select(l.x, l.y, (axis > 0.5f)), l.z, (axis > 1.5f));
      let sgn = select(-1f, 1f, (la >= 0f));
      let isX = select(0f, 1f, (axis < 0.5f));
      let isZ = select(0f, 1f, (axis > 1.5f));
      let isY = ((1f - isX) - isZ);
      let nx = (sgn * isX);
      let ny = (sgn * isY);
      let nz = (sgn * isZ);
      let bxv = (1f - isX);
      let byv = isX;
      let eyv = isZ;
      let ezv = (1f - isZ);
      let lb = ((l.x * bxv) + (l.y * byv));
      let lc = ((l.y * eyv) + (l.z * ezv));
      let h = ((v * 0.5f) * (*vx).voxelScale);
      let u = clamp(((lb / (2f * h)) + 0.5f), 0f, 1f);
      let w = clamp(((lc / (2f * h)) + 0.5f), 0f, 1f);
      let fx = (hh.cx + nx);
      let fy = (hh.cy + ny);
      let fz = (hh.cz + nz);
      let sB1 = occupied_6((fx - bxv), (fy - byv), fz);
      let sB2 = occupied_6((fx + bxv), (fy + byv), fz);
      let sC1 = occupied_6(fx, (fy - eyv), (fz - ezv));
      let sC2 = occupied_6(fx, (fy + eyv), (fz + ezv));
      let k11 = occupied_6((fx - bxv), ((fy - byv) - eyv), (fz - ezv));
      let k21 = occupied_6((fx + bxv), ((fy + byv) - eyv), (fz - ezv));
      let k12 = occupied_6((fx - bxv), ((fy - byv) + eyv), (fz + ezv));
      let k22 = occupied_6((fx + bxv), ((fy + byv) + eyv), (fz + ezv));
      let ao0 = mix(vertexAo_6(sB1, sC1, k11), vertexAo_6(sB2, sC1, k21), u);
      let ao1 = mix(vertexAo_6(sB1, sC2, k12), vertexAo_6(sB2, sC2, k22), u);
      let ao = mix(ao0, ao1, w);
      let faceId = ((axis * 2f) + max(sgn, 0f));
      fieldVal = (texel * -1f);
      payload = ((faceId * 65536f) + (floor(((ao * 255f) + 0.5f)) * 256f));
      cellPacked = ((hh.cx + (hh.cy * 256f)) + (hh.cz * 65536f));
      depth = hh.t;
    }
    else {
      fieldVal = (texel + max((hh.minD - v), 0f));
    }
  }
  return vec4f(fieldVal, payload, cellPacked, depth);
}

@group(1) @binding(0) var field_1: texture_storage_2d<rgba32float, write>;

fn volumetricFieldMarch(cx: u32, cy: u32) {
  let p = (&params);
  let activeResF = f32((*p).activeRes);
  let uv = vec2f(((*p).originX + (((f32(cx) + 0.5f) / activeResF) * (*p).spanX)), ((*p).originY + (((f32(cy) + 0.5f) / activeResF) * (*p).spanY)));
  let field = voxelFieldMarch_kernel(uv, (*p).rot, (*p).rBound);
  textureStore(field_1, vec2u(cx, cy), field);
}

fn voxelShadowCompare(tex: texture_2d<f32>, mx: f32, my: f32, ref_1: f32) -> f32 {
  const maxT = 1023f;
  let x0 = floor(mx);
  let y0 = floor(my);
  let fx = (mx - x0);
  let fy = (my - y0);
  let cx0 = u32(clamp(x0, 0f, maxT));
  let cx1 = u32(clamp((x0 + 1f), 0f, maxT));
  let cy0 = u32(clamp(y0, 0f, maxT));
  let cy1 = u32(clamp((y0 + 1f), 0f, maxT));
  let s00 = select(0f, 1f, (textureLoad(tex, vec2u(cx0, cy0), 0).r < ref_1));
  let s10 = select(0f, 1f, (textureLoad(tex, vec2u(cx1, cy0), 0).r < ref_1));
  let s01 = select(0f, 1f, (textureLoad(tex, vec2u(cx0, cy1), 0).r < ref_1));
  let s11 = select(0f, 1f, (textureLoad(tex, vec2u(cx1, cy1), 0).r < ref_1));
  return mix(mix(s00, s10, fx), mix(s01, s11, fx), fy);
}

fn voxelShadowLookup(tex: texture_2d<f32>, p: vec3f, L: vec3f, T1: vec3f, T2: vec3f, rBound: f32, softness: f32, voxel: f32) -> f32 {
  const RES = 1024f;
  let texelWorld = ((rBound * 2f) / RES);
  let u = dot(p, T1);
  let w = dot(p, T2);
  let dL = (rBound - dot(p, L));
  let mx = (((((u / rBound) * 0.5f) + 0.5f) * RES) - 0.5f);
  let my = (((((w / rBound) * 0.5f) + 0.5f) * RES) - 0.5f);
  let ref_1 = (dL - ((voxel * 0.05f) + (texelWorld * 2f)));
  var shadow = 0f;
  if ((softness < 1e-3f)) {
    shadow = voxelShadowCompare(tex, mx, my, ref_1);
  }
  else {
    let k = (softness * 0.27f);
    let rSearch = max((min((rBound * k), (rBound * 0.25f)) / texelWorld), 1f);
    var sum = 0f;
    var count = 0f;
    for (var s = 0; (s < 8i); s++) {
      let r = (sqrt(((f32(s) + 0.5f) / 8f)) * rSearch);
      let th = (f32(s) * 2.39996323f);
      let sx = clamp((mx + (cos(th) * r)), 0f, (RES - 1f));
      let sy = clamp((my + (sin(th) * r)), 0f, (RES - 1f));
      let dep = textureLoad(tex, vec2u(u32(sx), u32(sy)), 0).r;
      if ((dep < ref_1)) {
        sum = (sum + dep);
        count = (count + 1f);
      }
    }
    if ((count > 0.5f)) {
      let avgBlocker = (sum / count);
      let penumbra = clamp((((dL - avgBlocker) * k) / texelWorld), 1f, rSearch);
      var acc = 0f;
      for (var s = 0; (s < 12i); s++) {
        let r = (sqrt(((f32(s) + 0.5f) / 12f)) * penumbra);
        let th = ((f32(s) * 2.39996323f) + 0.7f);
        acc = (acc + voxelShadowCompare(tex, (mx + (cos(th) * r)), (my + (sin(th) * r)), ref_1));
      }
      shadow = (acc / 12f);
    }
  }
  return shadow;
}

fn fieldSampleTexelArg(uv: vec2f, field: texture_2d<f32>, originX: f32, originY: f32, spanX: f32, spanY: f32, activeResF: f32, rBound: f32) -> vec4f {
  let uxc = clamp(uv.x, originX, (originX + spanX));
  let uyc = clamp(uv.y, originY, (originY + spanY));
  let outsideDist = length(vec2f((uv.x - uxc), (uv.y - uyc)));
  let maxT = (activeResF - 1f);
  let px = clamp(floor((((uxc - originX) / spanX) * activeResF)), 0f, maxT);
  let py = clamp(floor((((uyc - originY) / spanY) * activeResF)), 0f, maxT);
  let t = textureLoad(field, vec2u(u32(px), u32(py)), 0);
  let rNear = (t.r + outsideDist);
  let rCircle = (length(vec2f((uv.x - 0.5f), (uv.y - 0.5f))) - rBound);
  let rOut = mix(rNear, max(rCircle, rNear), smoothstep(0f, 0.25f, outsideDist));
  return vec4f(rOut, t.g, t.b, t.a);
}

fn voxelRayBox(ro: vec3f, rd: vec3f, c: vec3f, h: f32) -> f32 {
  let sx = select(-1f, 1f, (rd.x >= 0f));
  let sy = select(-1f, 1f, (rd.y >= 0f));
  let sz = select(-1f, 1f, (rd.z >= 0f));
  let ix = (sx / max(abs(rd.x), 1e-6f));
  let iy = (sy / max(abs(rd.y), 1e-6f));
  let iz = (sz / max(abs(rd.z), 1e-6f));
  let t1x = (((c.x - h) - ro.x) * ix);
  let t2x = (((c.x + h) - ro.x) * ix);
  let t1y = (((c.y - h) - ro.y) * iy);
  let t2y = (((c.y + h) - ro.y) * iy);
  let t1z = (((c.z - h) - ro.z) * iz);
  let t2z = (((c.z + h) - ro.z) * iz);
  let tIn = max(min(t1x, t2x), max(min(t1y, t2y), min(t1z, t2z)));
  let tOut = min(max(t1x, t2x), min(max(t1y, t2y), max(t1z, t2z)));
  let ok = (select(0f, 1f, (tIn <= tOut)) * select(0f, 1f, (tOut >= 0f)));
  return select(-1f, max(tIn, 0f), (ok > 0.5f));
}

fn voxelRaySphere(ro: vec3f, rd: vec3f, c: vec3f, h: f32) -> f32 {
  let oc = (ro - c);
  let b = dot(oc, rd);
  let cc = (dot(oc, oc) - (h * h));
  let disc = ((b * b) - cc);
  let t = ((b * -1f) - sqrt(max(disc, 0f)));
  let ok = (select(0f, 1f, (disc >= 0f)) * select(0f, 1f, (t >= 0f)));
  return select(-1f, t, (ok > 0.5f));
}

fn voxelRayRoundedBox(ro: vec3f, rd: vec3f, c: vec3f, h: f32, r: f32) -> f32 {
  let tBox = voxelRayBox(ro, rd, c, h);
  var t = -1f;
  if ((tBox >= 0f)) {
    var s = tBox;
    var hit = 0f;
    for (var i = 0; (i < 8i); i++) {
      let p = ((ro + (rd * s)) - c);
      let dd = sdRoundBox(p, h, h, h, r);
      if ((dd < (h * 4e-3f))) {
        hit = 1f;
        break;
      }
      s = (s + dd);
      if ((s > (tBox + (h * 3.5f)))) {
        break;
      }
    }
    t = select(-1f, s, (hit > 0.5f));
  }
  return t;
}"
`;
