  var depth = (tEnd + 0.4f);
  if ((perp2 < (rBound * rBound))) {
    let maxSteps = i32(clamp((((rBound * 6f) / v) + 8f), 8f, 720f));
    let none = vec3f(-9999);
    let hh = voxelDda_3(ro, rd, tStart, tEnd, none, maxSteps);
    if ((hh.hit > 0.5f)) {
      let hp = (ro + (rd * hh.t));
      let c = cellCentre_3(hh.cx, hh.cy, hh.cz);
      let l = (hp - c);
      let alx = abs(l.x);
      let aly = abs(l.y);
      let alz = abs(l.z);
      var axis = 0f;
      if ((aly > alx)) {
        if ((aly >= alz)) {
          axis = 1f;
        }
        else {
          axis = 2f;
        }
      }
      else {
        if ((alz > alx)) {
          axis = 2f;
        }
      }
      let la = select(select(l.x, l.y, (axis > 0.5f)), l.z, (axis > 1.5f));
      let sgn = select(-1f, 1f, (la >= 0f));
      let isX = select(0f, 1f, (axis < 0.5f));
      let isZ = select(0f, 1f, (axis > 1.5f));
      let isY = ((1f - isX) - isZ);
      let nx = (sgn * isX);
      let ny = (sgn * isY);
      let nz = (sgn * isZ);
      let bxv = (1f - isX);
      let byv = isX;
      let eyv = isZ;
      let ezv = (1f - isZ);
      let lb = ((l.x * bxv) + (l.y * byv));
      let lc = ((l.y * eyv) + (l.z * ezv));
      let h = ((v * 0.5f) * (*vx).voxelScale);
      let u = clamp(((lb / (2f * h)) + 0.5f), 0f, 1f);
      let w = clamp(((lc / (2f * h)) + 0.5f), 0f, 1f);
      let fx = (hh.cx + nx);
      let fy = (hh.cy + ny);
      let fz = (hh.cz + nz);
      let sB1 = occupied_3((fx - bxv), (fy - byv), fz);
      let sB2 = occupied_3((fx + bxv), (fy + byv), fz);
      let sC1 = occupied_3(fx, (fy - eyv), (fz - ezv));
      let sC2 = occupied_3(fx, (fy + eyv), (fz + ezv));
      let k11 = occupied_3((fx - bxv), ((fy - byv) - eyv), (fz - ezv));
      let k21 = occupied_3((fx + bxv), ((fy + byv) - eyv), (fz - ezv));
      let k12 = occupied_3((fx - bxv), ((fy - byv) + eyv), (fz + ezv));
      let k22 = occupied_3((fx + bxv), ((fy + byv) + eyv), (fz + ezv));
      let ao0 = mix(vertexAo_3(sB1, sC1, k11), vertexAo_3(sB2, sC1, k21), u);
      let ao1 = mix(vertexAo_3(sB1, sC2, k12), vertexAo_3(sB2, sC2, k22), u);
      let ao = mix(ao0, ao1, w);
      let faceId = ((axis * 2f) + max(sgn, 0f));
