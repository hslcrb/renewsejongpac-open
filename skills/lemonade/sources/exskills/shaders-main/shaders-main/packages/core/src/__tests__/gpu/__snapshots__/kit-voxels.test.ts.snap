    if ((val < 0.5f)) {
      if ((same < 0.5f)) {
        let sh = subShapeHit_3(ro, rd, cellCentre_3(cx, cy, cz), t);
        if ((sh.hit > 0.5f)) {
          hit = 1f;
          tHit = sh.t;
          break;
        }
      }
    }
    if ((clear >= 1f)) {
      t = (t + (clear * v));
      let pj = (ro + (rd * t));
      cx = floor(((pj.x - o) / v));
      cy = floor(((pj.y - o) / v));
      cz = floor(((pj.z - o) / v));
      tmx = (t + ((((((cx + max(sx, 0f)) * v) + o) - pj.x) * sx) * ax));
      tmy = (t + ((((((cy + max(sy, 0f)) * v) + o) - pj.y) * sy) * ay));
      tmz = (t + ((((((cz + max(sz, 0f)) * v) + o) - pj.z) * sz) * az));
    }
    else {
      if ((tmx < tmy)) {
        if ((tmx < tmz)) {
          t = tmx;
          cx = (cx + sx);
          tmx = (tmx + dtx);
        }
        else {
          t = tmz;
          cz = (cz + sz);
          tmz = (tmz + dtz);
        }
      }
      else {
        if ((tmy < tmz)) {
          t = tmy;
          cy = (cy + sy);
          tmy = (tmy + dty);
        }
        else {
          t = tmz;
          cz = (cz + sz);
          tmz = (tmz + dtz);
        }
      }
    }
    if ((t > tEnd)) {
      break;
    }
  }
  return DdaHit_3(hit, tHit, cx, cy, cz, (minClear * v));
}

