  let sy = select(-1f, 1f, (rd.y >= 0f));
  let sz = select(-1f, 1f, (rd.z >= 0f));
  let ax = (1f / max(abs(rd.x), 1e-6f));
  let ay = (1f / max(abs(rd.y), 1e-6f));
  let az = (1f / max(abs(rd.z), 1e-6f));
  let dtx = (v * ax);
  let dty = (v * ay);
