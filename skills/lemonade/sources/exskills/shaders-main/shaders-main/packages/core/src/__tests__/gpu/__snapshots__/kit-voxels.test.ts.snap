}

fn voxelDda_1(ro: vec3f, rd: vec3f, tStart: f32, tEnd: f32, skip: vec3f, maxSteps: i32) -> DdaHit_1 {
  let vx = (&vox);
  let v = (*vx).voxelSize;
  let o = (*vx).gridOrigin;
  let p0 = (ro + (rd * tStart));
  var cx = floor(((p0.x - o) / v));
  var cy = floor(((p0.y - o) / v));
  var cz = floor(((p0.z - o) / v));
