fn voxelFieldMarch_sphere_view(fuv: vec2f, rot: RotStruct, rBound: f32) -> vec4f {
  let vx = (&vox);
  let v = (*vx).voxelSize;
  let ro = viewToGrid_3(vec3f((fuv.x - 0.5f), (0.5f - fuv.y), -1.2f), rot);
  let rd = viewToGrid_3(vec3f(0, 0, 1), rot);
  let b = dot(ro, rd);
  let perp2 = max((dot(ro, ro) - (b * b)), 0f);
  let halfSpan = sqrt(max(((rBound * rBound) - perp2), 0f));
  let tStart = max(((b * -1f) - halfSpan), 0f);
  let tEnd = (((b * -1f) + halfSpan) + 0.01f);
  let mp = (&params);
  let texel = (max((*mp).spanX, (*mp).spanY) / f32((*mp).activeRes));
  var fieldVal = ((sqrt(perp2) - rBound) + texel);
  var payload = 0f;
