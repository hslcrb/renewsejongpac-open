  let bx = (((cx + max(sx, 0f)) * v) + o);
  let by = (((cy + max(sy, 0f)) * v) + o);
  let bz = (((cz + max(sz, 0f)) * v) + o);
  var tmx = (tStart + (((bx - p0.x) * sx) * ax));
  var tmy = (tStart + (((by - p0.y) * sy) * ay));
  var tmz = (tStart + (((bz - p0.z) * sz) * az));
  var t = tStart;
  var hit = 0f;
  var tHit = tEnd;
  var minClear = 255f;
  for (var i = 0; (i < maxSteps); i++) {
    let same = step(((abs((cx - skip.x)) + abs((cy - skip.y))) + abs((cz - skip.z))), 0.5f);
    let val = cellValue_1(cx, cy, cz);
    let clear = max((val - 1f), 0f);
    minClear = min(minClear, clear);
