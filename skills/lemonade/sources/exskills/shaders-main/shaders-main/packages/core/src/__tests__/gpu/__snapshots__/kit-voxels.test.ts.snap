      if ((same < 0.5f)) {
        let sh = subShapeHit_1(ro, rd, cellCentre_1(cx, cy, cz), t);
        if ((sh.hit > 0.5f)) {
          hit = 1f;
          tHit = sh.t;
          break;
        }
