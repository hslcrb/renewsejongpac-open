  var cz = floor(((p0.z - o) / v));
  let sx = select(-1f, 1f, (rd.x >= 0f));
  let sy = select(-1f, 1f, (rd.y >= 0f));
  let sz = select(-1f, 1f, (rd.z >= 0f));
  let ax = (1f / max(abs(rd.x), 1e-6f));
  let ay = (1f / max(abs(rd.y), 1e-6f));
  let az = (1f / max(abs(rd.z), 1e-6f));
  let dtx = (v * ax);
  let dty = (v * ay);
  let dtz = (v * az);
  let bx = (((cx + max(sx, 0f)) * v) + o);
  let by = (((cy + max(sy, 0f)) * v) + o);
  let bz = (((cz + max(sz, 0f)) * v) + o);
  var tmx = (tStart + (((bx - p0.x) * sx) * ax));
  var tmy = (tStart + (((by - p0.y) * sy) * ay));
  var tmz = (tStart + (((bz - p0.z) * sz) * az));
  var t = tStart;
  var hit = 0f;
  var tHit = tEnd;
  var minClear = 255f;
  for (var i = 0; (i < maxSteps); i++) {
    let same = step(((abs((cx - skip.x)) + abs((cy - skip.y))) + abs((cz - skip.z))), 0.5f);
    let val = cellValue_3(cx, cy, cz);
    let clear = max((val - 1f), 0f);
